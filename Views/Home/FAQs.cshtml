@{
    ViewData["Title"] = "Frequently Asked Questions";
}

<!-- Premium Hero Banner -->
<section class="py-5 position-relative" style="background: radial-gradient(circle at 10% 20%, rgba(0, 119, 255, 0.08) 0%, transparent 60%); border-bottom: 1px solid var(--glass-border); padding-top: 100px !important;">
    <div class="container text-start">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-4 reveal-up">
            <ol class="breadcrumb" style="margin: 0; background: transparent;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-gradient-cyan text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-muted" aria-current="page">FAQs</li>
            </ol>
        </nav>
        
        <h1 class="display-3 text-white fw-bold mb-3 reveal-up" style="letter-spacing: -0.02em;">Help & FAQs</h1>
        <p class="text-muted fs-5 m-0 max-width-600 reveal-up" style="line-height: 1.6;">
            Find quick answers regarding admissions, dynamic assessments, lab rules, and scholarship criteria.
        </p>
    </div>
</section>

<!-- FAQ Accordion Layout -->
<section class="py-5" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="container max-width-800">
        
@model IEnumerable<NedAcademyWebsite.Models.FAQItem>
@using NedAcademyWebsite.Models

        <div class="accordion accordion-flush d-flex flex-column gap-3" id="faqAccordion">
            @{
                int index = 0;
                foreach (var faq in Model)
                {
                    var isShow = index == 0 ? "show" : "";
                    var isExpanded = index == 0 ? "true" : "false";
                    var btnCollapsed = index == 0 ? "" : "collapsed";
                    var collapseId = $"collapse_{faq.Id}";
                    var headingId = $"heading_{faq.Id}";
                    
                    <div class="glass-card p-0 overflow-hidden reveal-up" style="border: 1px solid var(--glass-border); border-radius: 12px;">
                        <h2 class="accordion-header m-0" id="@headingId">
                            <button class="btn w-100 text-start p-4 text-light font-headings fw-bold d-flex justify-content-between align-items-center @btnCollapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@isExpanded" aria-controls="@collapseId" style="background: transparent; border: none; box-shadow: none; font-size: 1.1rem;">
                                @faq.Question
                                <i class="fa-solid fa-chevron-down text-gradient-cyan" style="font-size: 0.9rem;"></i>
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @isShow" aria-labelledby="@headingId" data-bs-parent="#faqAccordion">
                            <div class="p-4 pt-0 text-muted" style="font-size: 0.95rem; line-height: 1.6; border-top: 1px solid rgba(255,255,255,0.03);">
                                @faq.Answer
                            </div>
                        </div>
                    </div>
                    
                    index++;
                }
            }
        </div>

        
    </div>
</section>
