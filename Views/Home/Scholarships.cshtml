@{
    ViewData["Title"] = "Scholarships & Financial Grants";
}

<!-- Premium Hero Banner -->
<section class="py-5 position-relative" style="background: radial-gradient(circle at 10% 20%, rgba(0, 119, 255, 0.08) 0%, transparent 60%); border-bottom: 1px solid var(--glass-border); padding-top: 100px !important;">
    <div class="container text-start">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-4 reveal-up">
            <ol class="breadcrumb" style="margin: 0; background: transparent;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-gradient-cyan text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Admissions" class="text-gradient-cyan text-decoration-none">Admissions</a></li>
                <li class="breadcrumb-item active text-muted" aria-current="page">Scholarships</li>
            </ol>
        </nav>
        
        <h1 class="display-3 text-white fw-bold mb-3 reveal-up" style="letter-spacing: -0.02em;">Scholarships & Grants</h1>
        <p class="text-muted fs-5 m-0 max-width-600 reveal-up" style="line-height: 1.6;">
            We believe dynamic intellect should never be limited by financing. Explore our merit awards and research stipends.
        </p>
    </div>
</section>

<!-- Scholarships Cards Grid -->
<section class="py-5" style="margin-top: 50px;">
    <div class="container text-start">
        <div class="row g-4">
            <!-- Scholarship 1: Merit -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card h-100 reveal-up d-flex flex-column justify-content-between" style="border-top: 3px solid var(--cyan);">
                    <div>
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-4" style="width: 50px; height: 50px; background: rgba(0, 242, 254, 0.08); border: 1px solid rgba(0, 242, 254, 0.15);">
                            <i class="fa-solid fa-award text-gradient-cyan" style="font-size: 1.3rem;"></i>
                        </div>
                        <h4 class="text-light mb-3" style="font-weight: 600;">VC Merit Scholarship</h4>
                        <span class="text-gradient-cyan fw-bold font-headings text-uppercase mb-3 d-block" style="font-size: 0.8rem;">100% Tuition Waiver</span>
                        <p class="text-muted" style="font-size: 0.92rem; line-height: 1.6;">
                            Awarded automatically to the top 5% of applicants clearing our dynamic aptitude assessment test. Covers entire tuition fees for the semester.
                        </p>
                        
                        <hr style="border-color: rgba(255,255,255,0.08); margin: 15px 0;" />
                        
                        <div style="font-size: 0.88rem;">
                            <span class="text-muted d-block">Eligibility:</span>
                            <span class="text-light">Min 85% score in admission test + Maintenance of 3.75 CGPA.</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Scholarship 2: Research -->
            <div class="col-lg-4 col-md-6">
                <div class="glass-card h-100 reveal-up d-flex flex-column justify-content-between" style="border-top: 3px solid var(--royal-blue);">
                    <div>
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-4" style="width: 50px; height: 50px; background: rgba(0, 119, 255, 0.08); border: 1px solid rgba(0, 119, 255, 0.15);">
                            <i class="fa-solid fa-atom text-gradient-blue" style="font-size: 1.3rem;"></i>
                        </div>
                        <h4 class="text-light mb-3" style="font-weight: 600;">Cyber Incubation Grant</h4>
                        <span class="text-gradient-blue fw-bold font-headings text-uppercase mb-3 d-block" style="font-size: 0.8rem;">Stipend + Computing Credits</span>
                        <p class="text-muted" style="font-size: 0.92rem; line-height: 1.6;">
                            Awarded to students contributing actively to research laboratories. Includes a monthly stipend and dedicated processing credits for GPU clusters.
                        </p>
                        
                        <hr style="border-color: rgba(255,255,255,0.08); margin: 15px 0;" />
                        
                        <div style="font-size: 0.88rem;">
                            <span class="text-muted d-block">Eligibility:</span>
                            <span class="text-light">Successful presentation of research layout before board panel.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scholarship 3: Need-Based -->
            <div class="col-lg-4 col-md-12">
                <div class="glass-card h-100 reveal-up d-flex flex-column justify-content-between" style="border-top: 3px solid var(--cyan);">
                    <div>
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-4" style="width: 50px; height: 50px; background: rgba(0, 242, 254, 0.08); border: 1px solid rgba(0, 242, 254, 0.15);">
                            <i class="fa-solid fa-hand-holding-dollar text-gradient-cyan" style="font-size: 1.3rem;"></i>
                        </div>
                        <h4 class="text-light mb-3" style="font-weight: 600;">Academic Support Assistance</h4>
                        <span class="text-gradient-cyan fw-bold font-headings text-uppercase mb-3 d-block" style="font-size: 0.8rem;">Up to 75% Support</span>
                        <p class="text-muted" style="font-size: 0.92rem; line-height: 1.6;">
                            Structured for qualifying families experiencing financial constraints. We review guardian earnings records to establish customized fee packages.
                        </p>
                        
                        <hr style="border-color: rgba(255,255,255,0.08); margin: 15px 0;" />
                        
                        <div style="font-size: 0.88rem;">
                            <span class="text-muted d-block">Eligibility:</span>
                            <span class="text-light">Submission of utility records, bank parameters, and income declarations.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Application Guidelines -->
<section class="py-5" style="margin-top: 50px; background: rgba(15,23,42,0.15); border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
    <div class="container text-start">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <h3 class="display-6 text-white mb-4" style="font-weight: 700;">How to Apply</h3>
                <p class="text-muted mb-4" style="line-height: 1.7;">
                    Scholarship forms are linked within the central Admissions Assessment Portal. Complete your admission registry profile, then follow these instructions:
                </p>
                <ol class="text-muted d-flex flex-column gap-3 mb-0" style="font-size: 0.95rem; line-height: 1.5;">
                    <li>Navigate to the **Scholarship Segment** in your dashboard.</li>
                    <li>Choose the grant program corresponding to your criteria (Merit, Need-based, or Research).</li>
                    <li>Upload verification documents (Utility reports, award letters, transcripts, or project proposals).</li>
                    <li>Submit the application prior to the dynamic admissions evaluation deadline.</li>
                </ol>
            </div>
            
            <div class="col-lg-6 ps-lg-5">
                <div class="glass-card p-4 reveal-up">
                    <h5 class="text-light mb-3" style="font-weight:600;"><i class="fa-solid fa-calendar text-gradient-cyan me-2"></i> Key Deadlines - Fall 2026</h5>
                    <div class="d-flex flex-column gap-3 text-muted" style="font-size: 0.92rem;">
                        <div class="d-flex justify-content-between">
                            <span>Admission Test Registration:</span>
                            <span class="text-white fw-bold">August 10, 2026</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Scholarship Documents Submission:</span>
                            <span class="text-white fw-bold">August 12, 2026</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Review Outcomes Notification:</span>
                            <span class="text-gradient-cyan fw-bold">August 25, 2026</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Final Call to Action -->
<section class="py-5 mb-5 reveal-up" style="margin-top: 80px;">
    <div class="container text-center">
        <div class="glass-card p-5" style="border-top: 3px solid var(--cyan); background: radial-gradient(ellipse at bottom, rgba(0, 242, 254, 0.08) 0%, transparent 60%);">
            <h3 class="text-light mb-3" style="font-weight:700;">Explore Funding Details</h3>
            <p class="text-muted max-width-600 mx-auto mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                Need help or clarification on financial models? Talk directly to our financial advisory team.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Home" asp-action="Contact" class="btn btn-cyber">Contact Support</a>
                <a asp-controller="Home" asp-action="Downloads" class="btn btn-cyber-outline">Download Forms</a>
            </div>
        </div>
    </div>
</section>
