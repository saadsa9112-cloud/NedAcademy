@{
    ViewData["Title"] = "Contact Support & Campus Directions";
}

<!-- Premium Hero Banner -->
<section class="py-5 position-relative" style="background: radial-gradient(circle at 10% 20%, rgba(0, 119, 255, 0.08) 0%, transparent 60%); border-bottom: 1px solid var(--glass-border); padding-top: 100px !important;">
    <div class="container text-start">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-4 reveal-up">
            <ol class="breadcrumb" style="margin: 0; background: transparent;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-gradient-cyan text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-muted" aria-current="page">Contact Us</li>
            </ol>
        </nav>
        
        <h1 class="display-3 text-white fw-bold mb-3 reveal-up" style="letter-spacing: -0.02em;">Contact Us</h1>
        <p class="text-muted fs-5 m-0 max-width-600 reveal-up" style="line-height: 1.6;">
            Get in touch with our technical counselors, administrative assistants, or register campus visits.
        </p>
    </div>
</section>

@model NedAcademyWebsite.Models.SystemSetting

<!-- Split Section: Contact Form & Info -->
<section class="py-5" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="container text-start">
        <div class="row g-5">
            
            <!-- Left Side: Interactive Contact Form -->
            <div class="col-lg-7">
                <div class="glass-card p-5 reveal-up" style="border-top: 3px solid var(--cyan);">
                    <h3 class="text-light mb-4" style="font-weight: 700;">Submit Inquiry</h3>
                    <p class="text-muted mb-4" style="font-size: 0.92rem;">Please fill out the form parameters below, and our team will get back to you within 24 hours.</p>
                    
                    <form id="contactForm" class="d-flex flex-column gap-3">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted font-headings mb-1" style="font-size:0.82rem; font-weight:600; text-transform:uppercase;">Your Name</label>
                                <input type="text" id="contactName" name="Name" class="form-control" placeholder="John Doe" required style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; font-size: 0.92rem; padding: 12px 16px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted font-headings mb-1" style="font-size:0.82rem; font-weight:600; text-transform:uppercase;">Email Address</label>
                                <input type="email" id="contactEmail" name="Email" class="form-control" placeholder="john@example.com" required style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; font-size: 0.92rem; padding: 12px 16px;" />
                            </div>
                        </div>
                        
                        <div>
                            <label class="text-muted font-headings mb-1" style="font-size:0.82rem; font-weight:600; text-transform:uppercase;">Subject</label>
                            <input type="text" id="contactSubject" name="Subject" class="form-control" placeholder="Admission inquiry" required style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; font-size: 0.92rem; padding: 12px 16px;" />
                        </div>
                        
                        <div>
                            <label class="text-muted font-headings mb-1" style="font-size:0.82rem; font-weight:600; text-transform:uppercase;">Message</label>
                            <textarea id="contactMessage" name="Message" class="form-control" rows="5" placeholder="Write your queries here..." required style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; font-size: 0.92rem; padding: 12px 16px; resize:none;"></textarea>
                        </div>
                        
                        <div class="mt-3">
                            <button type="submit" class="btn btn-cyber w-100 py-3 text-uppercase font-headings" style="font-size:0.88rem; letter-spacing:0.05em;">Send Message</button>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Right Side: Contact Information & Location Map -->
            <div class="col-lg-5 ps-lg-4">
                <h3 class="display-6 text-white mb-4" style="font-weight: 700;">Inquiries Desk</h3>
                
                <div class="d-flex flex-column gap-4 mb-5">
                    
                    <div class="d-flex gap-3 align-items-start">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary" style="width: 45px; height: 45px; flex-shrink: 0;">
                            <i class="fa-solid fa-phone text-white" style="font-size: 1.1rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-light mb-1" style="font-weight: 600;">Academic Helpline</h6>
                            <span class="text-muted d-block" style="font-size: 0.9rem;">@Model.ContactPhone</span>
                            <span class="text-muted d-block" style="font-size: 0.9rem;">Mon - Fri | 09:00 AM - 05:00 PM</span>
                        </div>
                    </div>
 
                    <div class="d-flex gap-3 align-items-start">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary" style="width: 45px; height: 45px; flex-shrink: 0;">
                            <i class="fa-solid fa-envelope text-white" style="font-size: 1.1rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-light mb-1" style="font-weight: 600;">Digital Mailing</h6>
                            <span class="text-muted d-block" style="font-size: 0.9rem;">@Model.ContactEmail</span>
                        </div>
                    </div>
 
                    <div class="d-flex gap-3 align-items-start">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary" style="width: 45px; height: 45px; flex-shrink: 0;">
                            <i class="fa-solid fa-location-dot text-white" style="font-size: 1.1rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-light mb-1" style="font-weight: 600;">Main Address</h6>
                            <span class="text-muted d-block" style="font-size: 0.9rem; line-height: 1.5;">
                                @Model.Address
                            </span>
                        </div>
                    </div>
 
                </div>
                
                <!-- Google Maps Location Placeholder -->
                <div class="glass-card p-4 reveal-up" style="border-left: 3px solid var(--royal-blue); background: rgba(15,23,42,0.3);">
                    <h5 class="text-light mb-3" style="font-weight:600;"><i class="fa-solid fa-compass text-gradient-blue me-2"></i> Campus Coordinates</h5>
                    <p class="text-muted mb-3" style="font-size:0.9rem; line-height:1.5;">We are located inside the main NED UET campus. Visitor registration slips can be acquired at Gate 1 or Gate 2.</p>
                    <div class="p-3 rounded text-center text-gradient-cyan fw-bold font-headings" style="background: rgba(255,255,255,0.02); border: 1px dashed var(--glass-border); font-size:0.9rem;">
                        <i class="fa-solid fa-map-location-dot me-2"></i> Lat: @Model.MapsLatitude.ToString("F4")° N | Lon: @Model.MapsLongitude.ToString("F4")° E
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>
 
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contactForm');
            if (form) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    
                    const name = document.getElementById('contactName').value.trim();
                    const email = document.getElementById('contactEmail').value.trim();
                    const subject = document.getElementById('contactSubject').value.trim();
                    const message = document.getElementById('contactMessage').value.trim();
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    
                    if (name && email && subject && message) {
                        const formData = new FormData();
                        formData.append('Name', name);
                        formData.append('Email', email);
                        formData.append('Subject', subject);
                        formData.append('Message', message);
                        formData.append('__RequestVerificationToken', token);
 
                        fetch('/Home/SubmitContact', {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: 'Message Dispatched!',
                                    text: data.message,
                                    icon: 'success',
                                    background: '#0b1329',
                                    color: '#f8fafc',
                                    confirmButtonColor: '#0077ff',
                                    confirmButtonText: 'Acknowledge',
                                    customClass: {
                                        popup: 'glass-card border-0'
                                    }
                                });
                                form.reset();
                            } else {
                                Swal.fire({
                                    title: 'Submission Failed',
                                    text: data.message,
                                    icon: 'error',
                                    background: '#0b1329',
                                    color: '#f8fafc',
                                    confirmButtonColor: '#ff3b30',
                                    confirmButtonText: 'Retry'
                                });
                            }
                        })
                        .catch(err => {
                            Swal.fire({
                                title: 'Error',
                                text: 'Connection failed. Please check network constraints.',
                                icon: 'error',
                                background: '#0b1329',
                                color: '#f8fafc',
                                confirmButtonColor: '#ff3b30'
                            });
                        });
                    }
                });
            }
        });
    </script>
}

