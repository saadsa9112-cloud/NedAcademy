@{
    ViewData["Title"] = "Admissions - Fall 2026 Guidelines";
}

<!-- Premium Hero Banner -->
<section class="py-5 position-relative" style="background: radial-gradient(circle at 10% 20%, rgba(0, 119, 255, 0.08) 0%, transparent 60%); border-bottom: 1px solid var(--glass-border); padding-top: 100px !important;">
    <div class="container text-start">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-4 reveal-up">
            <ol class="breadcrumb" style="margin: 0; background: transparent;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-gradient-cyan text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-muted" aria-current="page">Admissions</li>
            </ol>
        </nav>
        
        <h1 class="display-3 text-white fw-bold mb-3 reveal-up" style="letter-spacing: -0.02em;">Admission Guidelines</h1>
        <p class="text-muted fs-5 m-0 max-width-600 reveal-up" style="line-height: 1.6;">
            Learn about our selective admission stages, documentation checklists, and application steps.
        </p>
    </div>
</section>

<!-- Admissions Steps Timeline -->
<section class="py-5" style="margin-top: 50px;">
    <div class="container text-start">
        <div class="text-center mb-5 max-width-600 mx-auto">
            <h2 class="display-5 text-white mb-3" style="font-weight: 700;">Admissions Process</h2>
            <p class="text-muted">A clear, merit-driven evaluation pipeline designed to verify quantitative and analytical capabilities.</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            <!-- Step 1 -->
            <div class="col-lg-3 col-md-6">
                <div class="glass-card text-start h-100 reveal-up d-flex flex-column justify-content-between" style="border-top: 2px solid var(--cyan);">
                    <div>
                        <span class="text-gradient-cyan font-headings fw-bold mb-2 d-block" style="font-size: 1.3rem;">01</span>
                        <h5 class="text-light mb-2" style="font-weight: 600;">Online Registration</h5>
                        <p class="text-muted" style="font-size: 0.88rem; line-height: 1.5; margin: 0;">Submit academic documents, transcripts, and basic particulars through our online portal.</p>
                    </div>
                </div>
            </div>
            
            <!-- Step 2 -->
            <div class="col-lg-3 col-md-6">
                <div class="glass-card text-start h-100 reveal-up d-flex flex-column justify-content-between" style="border-top: 2px solid var(--royal-blue);">
                    <div>
                        <span class="text-gradient-blue font-headings fw-bold mb-2 d-block" style="font-size: 1.3rem;">02</span>
                        <h5 class="text-light mb-2" style="font-weight: 600;">Entrance Test</h5>
                        <p class="text-muted" style="font-size: 0.88rem; line-height: 1.5; margin: 0;">Attempt the quantitative math and logical programming diagnostic test.</p>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-lg-3 col-md-6">
                <div class="glass-card text-start h-100 reveal-up d-flex flex-column justify-content-between" style="border-top: 2px solid var(--cyan);">
                    <div>
                        <span class="text-gradient-cyan font-headings fw-bold mb-2 d-block" style="font-size: 1.3rem;">03</span>
                        <h5 class="text-light mb-2" style="font-weight: 600;">Panel Interview</h5>
                        <p class="text-muted" style="font-size: 0.88rem; line-height: 1.5; margin: 0;">Present your prior project models and discuss system career interests before an academic board.</p>
                    </div>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="col-lg-3 col-md-6">
                <div class="glass-card text-start h-100 reveal-up d-flex flex-column justify-content-between" style="border-top: 2px solid var(--royal-blue);">
                    <div>
                        <span class="text-gradient-blue font-headings fw-bold mb-2 d-block" style="font-size: 1.3rem;">04</span>
                        <h5 class="text-light mb-2" style="font-weight: 600;">Final Enrollment</h5>
                        <p class="text-muted" style="font-size: 0.88rem; line-height: 1.5; margin: 0;">Deposit registration credentials, verify original records, and reserve your cohort place.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Eligibility & Checklist Documents Split -->
<section id="eligibility" class="py-5" style="margin-top: 50px; background: rgba(15,23,42,0.15); border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
    <div class="container text-start">
        <div class="row gy-5">
            <!-- Left Column: Eligibility -->
            <div class="col-lg-6">
                <h3 class="display-6 text-white mb-4" style="font-weight: 700;">Eligibility Thresholds</h3>
                <div class="d-flex flex-column gap-3">
                    <div class="glass-card p-4 reveal-up">
                        <h5 class="text-light" style="font-weight:600;"><i class="fa-solid fa-graduation-cap text-gradient-cyan me-2"></i> HS Certificate (Pre-Engineering)</h5>
                        <p class="text-muted m-0" style="font-size: 0.92rem; line-height: 1.5;">Minimum 60% aggregate marks. Math, Physics, and Chemistry modules are mandatory prerequisites.</p>
                    </div>
                    <div class="glass-card p-4 reveal-up">
                        <h5 class="text-light" style="font-weight:600;"><i class="fa-solid fa-laptop-code text-gradient-blue me-2"></i> GCE A-Levels Equivalent</h5>
                        <p class="text-muted m-0" style="font-size: 0.92rem; line-height: 1.5;">Three principal passes in Mathematics, Physics, and Chemistry. Equivalence certificate from IBCC is required.</p>
                    </div>
                </div>
            </div>
            
            <!-- Right Column: Document Checklist -->
            <div class="col-lg-6 ps-lg-5">
                <h3 class="display-6 text-white mb-4" style="font-weight: 700;">Required Documents</h3>
                <p class="text-muted mb-4">Please prepare digital and physical copies of the following documents before final assessment enrollment:</p>
                
                <ul class="list-unstyled d-flex flex-column gap-3 text-muted" style="font-size: 0.95rem;">
                    <li><i class="fa-solid fa-circle-nodes text-gradient-cyan me-2"></i> Intermediate (or A-Level) Marksheets & Certificate copies</li>
                    <li><i class="fa-solid fa-circle-nodes text-gradient-cyan me-2"></i> Matriculation (or O-Level) Certificate copy</li>
                    <li><i class="fa-solid fa-circle-nodes text-gradient-cyan me-2"></i> Applicant's National Identity Card (CNIC/B-Form) copy</li>
                    <li><i class="fa-solid fa-circle-nodes text-gradient-cyan me-2"></i> Guardian's National Identity Card copy</li>
                    <li><i class="fa-solid fa-circle-nodes text-gradient-cyan me-2"></i> Equivalent cert from IBCC (if qualifying outside domestic boards)</li>
                    <li><i class="fa-solid fa-circle-nodes text-gradient-cyan me-2"></i> Portfolio summary or code repository link (optional but highly recommended)</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Admissions Open Promo / CTA -->
<section class="py-5 mb-5 reveal-up" style="margin-top: 80px;">
    <div class="container text-center">
        <div class="glass-card p-5" style="border-top: 3px solid var(--cyan); background: radial-gradient(ellipse at bottom, rgba(0, 242, 254, 0.08) 0%, transparent 60%);">
            <h3 class="text-light mb-3" style="font-weight:700;">Take the First Step Today</h3>
            <p class="text-muted max-width-600 mx-auto mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                Review schedules, download brochures, and set up your admission assessment portal profile.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="https://portal.nedacademy.edu" class="btn btn-cyber" target="_blank">Proceed to Online Portal</a>
                <a asp-controller="Home" asp-action="Downloads" class="btn btn-cyber-outline">Download Prospectus</a>
            </div>
        </div>
    </div>
</section>
