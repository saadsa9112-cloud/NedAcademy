@using NedAcademyWebsite.Models
@{
    Layout = "_ApplicantLayout";
    ViewData["Title"] = "Applicant Status Center";

    var applicant = ViewBag.Applicant as Applicant;
    var profile = ViewBag.ApplicantProfile as ApplicantProfile;
    var applications = ViewBag.Applications as IEnumerable<AdmissionApplication> ?? new List<AdmissionApplication>();
    var latestApp = applications.FirstOrDefault();
    var activeSession = ViewBag.ActiveSession as AdmissionSession;
    var enrollment = ViewBag.EnrollmentRecord as EnrollmentRecord;
    var documents = ViewBag.Documents as IEnumerable<ApplicationDocument> ?? new List<ApplicationDocument>();
    var timelineLogs = ViewBag.TimelineLogs as IEnumerable<ApplicationTimelineLog> ?? new List<ApplicationTimelineLog>();
    var notifications = ViewBag.Notifications as IEnumerable<ApplicantNotification> ?? new List<ApplicantNotification>();

    var testSchedule = ViewBag.TestSchedule as AdmissionTestSchedule;
    var testResult = ViewBag.TestResult as AdmissionTestResult;
    var rejectedDocs = documents.Where(d => d.VerificationStatus == DocumentVerificationStatus.Rejected || d.VerificationStatus == DocumentVerificationStatus.NeedReupload).ToList();

    var vouchers = latestApp?.FeeVouchers ?? new List<FeeVoucher>();
    var processingVoucher = vouchers.FirstOrDefault(v => v.VoucherType.Equals("ProcessingFee", StringComparison.OrdinalIgnoreCase));
    var semesterVoucher = vouchers.FirstOrDefault(v => v.VoucherType.Equals("FirstSemesterFee", StringComparison.OrdinalIgnoreCase) || v.VoucherType.Equals("AdmissionFee", StringComparison.OrdinalIgnoreCase));

    int profilePct = profile?.ProfileCompletionPercentage ?? 0;
    int docCount = documents.Count();
    int verifiedDocs = documents.Count(d => d.VerificationStatus == DocumentVerificationStatus.Verified);
    
    // Lifecycle Stage Flags
    bool isAppSubmitted = latestApp != null && latestApp.CurrentStatus >= ApplicationStatus.Submitted;
    bool isProcessingFeePaid = processingVoucher != null && (processingVoucher.PaymentStatus == PaymentStatus.Paid || processingVoucher.VoucherStatus == VoucherStatus.Paid);
    bool isDocsVerified = latestApp != null && latestApp.CurrentStatus >= ApplicationStatus.DocumentsVerified;
    bool isTestScheduled = testSchedule != null || (latestApp != null && latestApp.CurrentStatus >= ApplicationStatus.TestScheduled);
    bool isTestCompleted = testResult != null;
    bool isTestQualified = testResult != null && testResult.IsQualified;
    bool isSemesterFeePaid = semesterVoucher != null && (semesterVoucher.PaymentStatus == PaymentStatus.Paid || semesterVoucher.VoucherStatus == VoucherStatus.Paid);
    bool isPortalActive = (enrollment != null && enrollment.EnrollmentStatus == "Active") || (latestApp != null && latestApp.CurrentStatus == ApplicationStatus.Approved);

    // Current linear step
    int currentActiveStep = 1;
    if (isPortalActive) currentActiveStep = 6;
    else if (isSemesterFeePaid) currentActiveStep = 6;
    else if (isTestCompleted && isTestQualified) currentActiveStep = 5;
    else if (isTestScheduled || isDocsVerified) currentActiveStep = 4;
    else if (isProcessingFeePaid) currentActiveStep = 3;
    else if (isAppSubmitted) currentActiveStep = 2;
    else currentActiveStep = 1;
}

<div class="container-fluid p-0">
    <!-- Notifications Area -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" style="border-radius: 10px;" role="alert">
            <i class="fa-solid fa-circle-check me-2 fa-lg"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" style="border-radius: 10px;" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2 fa-lg"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ═══════ REJECTED DOCUMENTS WARNING ALERT ═══════ -->
    @if (rejectedDocs.Any())
    {
        <div class="portal-card p-3 mb-4 border-danger" style="border-left: 5px solid #ef4444 !important; background: rgba(239, 68, 68, 0.05);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger fs-4">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-danger font-headings">Action Required: @rejectedDocs.Count Document(s) Require Re-upload</h6>
                        <div class="small text-muted">
                            @foreach (var rd in rejectedDocs)
                            {
                                <div>• <strong>@rd.DocumentType:</strong> @(rd.VerificationRemarks ?? rd.RejectionReason ?? "Uploaded file does not meet clarity requirements")</div>
                            }
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Documents", "Admission")" class="btn btn-danger font-headings px-3 btn-sm">
                    <i class="fa-solid fa-cloud-arrow-up me-1"></i> Re-upload Documents
                </a>
            </div>
        </div>
    }

    <!-- ═══════ WELCOME HERO BANNER (CLEAN & GUIDED) ═══════ -->
    <div class="portal-card p-4 mb-4" style="background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(16, 185, 129, 0.06) 100%); border-left: 5px solid var(--portal-blue, #2563eb);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white font-headings fw-bold shadow-sm"
                     style="width: 58px; height: 58px; background: linear-gradient(135deg, #2563eb, #1d4ed8); font-size: 1.4rem;">
                    @((applicant?.FullName ?? "A")[0])
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-primary bg-opacity-10 text-primary font-headings px-2 py-1">
                            <i class="fa-solid fa-calendar-days me-1"></i> @(activeSession?.Title ?? "Spring 2026 Admissions")
                        </span>
                        @if (isPortalActive)
                        {
                            <span class="badge bg-success font-headings px-2 py-1">
                                <i class="fa-solid fa-circle-check me-1"></i> ADMISSION CONFIRMED
                            </span>
                        }
                        else if (isAppSubmitted)
                        {
                            <span class="badge bg-info text-dark font-headings px-2 py-1">
                                <i class="fa-solid fa-clock me-1"></i> Application Submitted (@latestApp?.CurrentStatus)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark font-headings px-2 py-1">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Application Draft (Action Required)
                            </span>
                        }
                    </div>
                    <h2 class="portal-content-title mb-1">Welcome back, @(applicant?.FullName ?? "Applicant")</h2>
                    <p class="text-muted small mb-0">
                        Application Ref: <strong>@(latestApp?.ApplicationNumber ?? "Draft (Not Submitted Yet)")</strong> | 
                        Target Program: <strong class="text-primary">@(latestApp?.DegreeProgram?.Name ?? "Select Degree Program")</strong>
                    </p>
                </div>
            </div>

            <!-- Smart Adaptive Call-to-Action -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (isPortalActive)
                {
                    <a href="@Url.Action("StudentPortal", "Admission")" class="portal-btn portal-btn-primary portal-btn-lg">
                        <i class="fa-solid fa-graduation-cap me-1"></i> Open Student Portal (Active)
                    </a>
                }
                else if (!isAppSubmitted)
                {
                    <a href="@Url.Action("Apply", "Admission")" class="portal-btn portal-btn-primary portal-btn-lg shadow-sm">
                        <i class="fa-solid fa-arrow-right me-1"></i> Complete &amp; Submit Application Form
                    </a>
                }
                else if (!isProcessingFeePaid)
                {
                    <a href="@Url.Action("FeeVouchers", "Admission")" class="portal-btn portal-btn-primary portal-btn-lg shadow-sm">
                        <i class="fa-solid fa-receipt me-1"></i> Deposit Processing Fee Voucher
                    </a>
                }
                else if (docCount < 3)
                {
                    <a href="@Url.Action("Documents", "Admission")" class="portal-btn portal-btn-primary portal-btn-lg shadow-sm">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload Required Documents
                    </a>
                }
                else if (semesterVoucher != null && !isSemesterFeePaid)
                {
                    <a href="@Url.Action("FeeVouchers", "Admission")" class="portal-btn portal-btn-primary portal-btn-lg" style="background:#10b981;">
                        <i class="fa-solid fa-receipt me-1"></i> Pay 1st Semester Tuition Fee
                    </a>
                }
                else
                {
                    <a href="@Url.Action("StudentPortal", "Admission")" class="portal-btn portal-btn-outline portal-btn-lg">
                        <i class="fa-solid fa-route me-1"></i> Track Detailed Progress
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- ═══════ 4 KEY METRICS SUMMARY ROW ═══════ -->
    <div class="row g-3 mb-4">
        <!-- 1. Application Status -->
        <div class="col-xl-3 col-sm-6">
            <div class="portal-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary fs-4" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-file-signature"></i>
                    </div>
                    <div>
                        <div class="small text-uppercase font-headings fw-bold text-muted" style="font-size:0.7rem;">Application Status</div>
                        <h6 class="font-headings fw-bold mb-0 mt-1">
                            @if (isPortalActive)
                            {
                                <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Enrolled</span>
                            }
                            else if (latestApp != null)
                            {
                                <span class="text-primary">@latestApp.CurrentStatus</span>
                            }
                            else
                            {
                                <span class="text-warning">Draft (Incomplete)</span>
                            }
                        </h6>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Profile Completion -->
        <div class="col-xl-3 col-sm-6">
            <div class="portal-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-4" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                    <div class="w-100 pe-2">
                        <div class="small text-uppercase font-headings fw-bold text-muted" style="font-size:0.7rem;">Profile Completion</div>
                        <h6 class="font-headings fw-bold mb-1 mt-1">@profilePct% Complete</h6>
                        <div class="progress" style="height: 6px; background: rgba(0,0,0,0.06);">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @profilePct%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Document Scrutiny -->
        <div class="col-xl-3 col-sm-6">
            <div class="portal-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning fs-4" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-folder-open"></i>
                    </div>
                    <div>
                        <div class="small text-uppercase font-headings fw-bold text-muted" style="font-size:0.7rem;">Document Scrutiny</div>
                        <h6 class="font-headings fw-bold mb-0 mt-1">
                            @if (docCount > 0)
                            {
                                <span class="@(verifiedDocs == docCount ? "text-success" : "text-warning")">@verifiedDocs / @docCount Verified</span>
                            }
                            else
                            {
                                <span class="text-muted">Pending Upload</span>
                            }
                        </h6>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Fee Payment Status -->
        <div class="col-xl-3 col-sm-6">
            <div class="portal-card p-3 h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info fs-4" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                    <div>
                        <div class="small text-uppercase font-headings fw-bold text-muted" style="font-size:0.7rem;">Tuition Fee Status</div>
                        <h6 class="font-headings fw-bold mb-0 mt-1">
                            @if (isSemesterFeePaid)
                            {
                                <span class="text-success"><i class="fa-solid fa-check me-1"></i> Paid &amp; Cleared</span>
                            }
                            else if (isProcessingFeePaid)
                            {
                                <span class="text-primary"><i class="fa-solid fa-check me-1"></i> Processing Cleared</span>
                            }
                            else
                            {
                                <span class="text-warning">Pending Payment</span>
                            }
                        </h6>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════ SEQUENTIAL ADMISSION PROGRESSION ROADMAP ═══════ -->
    <div class="portal-card mb-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h5 class="font-headings fw-bold m-0"><i class="fa-solid fa-route text-primary me-2"></i> Admission Progression Roadmap</h5>
                <p class="text-muted small m-0">Linear step-by-step path from initial form submission to university enrollment.</p>
            </div>
            <span class="badge @(isPortalActive ? "bg-success" : "bg-primary") font-headings px-3 py-2">
                @(isPortalActive ? "All Steps Completed (100%)" : $"Current Stage: Step {currentActiveStep} of 6")
            </span>
        </div>

        <div class="row g-3">
            <!-- Step 1: Form Submission -->
            <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="p-3 rounded-3 border text-center h-100 @(isAppSubmitted ? "border-success" : (currentActiveStep == 1 ? "border-primary" : "border-secondary"))"
                     style="background: @(isAppSubmitted ? "rgba(16, 185, 129, 0.08)" : (currentActiveStep == 1 ? "rgba(37, 99, 235, 0.08)" : "var(--portal-surface-2)"));">
                    <div class="mb-2">
                        @if (isAppSubmitted) { <i class="fa-solid fa-circle-check text-success fa-xl"></i> }
                        else if (currentActiveStep == 1) { <span class="badge bg-primary font-headings">Active Step 1</span> }
                        else { <span class="badge bg-secondary font-headings">1</span> }
                    </div>
                    <div class="font-headings fw-bold small">1. Form Submission</div>
                    <div class="text-muted small" style="font-size:0.75rem;">
                        @(isAppSubmitted ? "Form Submitted" : "Action Required")
                    </div>
                </div>
            </div>

            <!-- Step 2: Processing Fee -->
            <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="p-3 rounded-3 border text-center h-100 @(isProcessingFeePaid ? "border-success" : (currentActiveStep == 2 ? "border-warning" : "border-secondary"))"
                     style="background: @(isProcessingFeePaid ? "rgba(16, 185, 129, 0.08)" : (currentActiveStep == 2 ? "rgba(245, 158, 11, 0.08)" : "var(--portal-surface-2)"));">
                    <div class="mb-2">
                        @if (isProcessingFeePaid) { <i class="fa-solid fa-circle-check text-success fa-xl"></i> }
                        else if (currentActiveStep == 2) { <span class="badge bg-warning text-dark font-headings">Deposit Fee</span> }
                        else { <i class="fa-solid fa-lock text-muted"></i> }
                    </div>
                    <div class="font-headings fw-bold small">2. Processing Fee</div>
                    <div class="text-muted small" style="font-size:0.75rem;">
                        @(isProcessingFeePaid ? "Paid & Cleared" : (isAppSubmitted ? "Pending Deposit" : "Locked"))
                    </div>
                </div>
            </div>

            <!-- Step 3: Document Scrutiny -->
            <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="p-3 rounded-3 border text-center h-100 @(isDocsVerified ? "border-success" : (currentActiveStep == 3 ? "border-info" : "border-secondary"))"
                     style="background: @(isDocsVerified ? "rgba(16, 185, 129, 0.08)" : (currentActiveStep == 3 ? "rgba(6, 182, 212, 0.08)" : "var(--portal-surface-2)"));">
                    <div class="mb-2">
                        @if (isDocsVerified) { <i class="fa-solid fa-circle-check text-success fa-xl"></i> }
                        else if (currentActiveStep == 3) { <span class="badge bg-info text-dark font-headings">In Review</span> }
                        else { <i class="fa-solid fa-lock text-muted"></i> }
                    </div>
                    <div class="font-headings fw-bold small">3. Scrutiny</div>
                    <div class="text-muted small" style="font-size:0.75rem;">
                        @(isDocsVerified ? "Verified" : (isProcessingFeePaid ? "Under Review" : "Locked"))
                    </div>
                </div>
            </div>

            <!-- Step 4: Entrance Test -->
            <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="p-3 rounded-3 border text-center h-100 @(isTestCompleted ? "border-success" : (currentActiveStep == 4 ? "border-primary" : "border-secondary"))"
                     style="background: @(isTestCompleted ? "rgba(16, 185, 129, 0.08)" : (currentActiveStep == 4 ? "rgba(37, 99, 235, 0.08)" : "var(--portal-surface-2)"));">
                    <div class="mb-2">
                        @if (isTestCompleted) { <i class="fa-solid fa-circle-check text-success fa-xl"></i> }
                        else if (currentActiveStep == 4 && isTestScheduled) { <span class="badge bg-primary font-headings">Scheduled</span> }
                        else if (currentActiveStep == 4) { <span class="badge bg-secondary font-headings">Awaiting Date</span> }
                        else { <i class="fa-solid fa-lock text-muted"></i> }
                    </div>
                    <div class="font-headings fw-bold small">4. Entrance Test</div>
                    <div class="text-muted small" style="font-size:0.75rem;">
                        @(isTestCompleted ? $"{testResult?.CalculatedPercentage}% Qualified" : (isTestScheduled ? "Admit Card Ready" : "Locked"))
                    </div>
                </div>
            </div>

            <!-- Step 5: Semester Tuition Fee -->
            <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="p-3 rounded-3 border text-center h-100 @(isSemesterFeePaid ? "border-success" : (currentActiveStep == 5 ? "border-warning" : "border-secondary"))"
                     style="background: @(isSemesterFeePaid ? "rgba(16, 185, 129, 0.08)" : (currentActiveStep == 5 ? "rgba(245, 158, 11, 0.08)" : "var(--portal-surface-2)"));">
                    <div class="mb-2">
                        @if (isSemesterFeePaid) { <i class="fa-solid fa-circle-check text-success fa-xl"></i> }
                        else if (currentActiveStep == 5) { <span class="badge bg-warning text-dark font-headings">Action Required</span> }
                        else { <i class="fa-solid fa-lock text-muted"></i> }
                    </div>
                    <div class="font-headings fw-bold small">5. Semester Fee</div>
                    <div class="text-muted small" style="font-size:0.75rem;">
                        @(isSemesterFeePaid ? "Paid & Verified" : (currentActiveStep == 5 ? "Voucher Generated" : "Locked"))
                    </div>
                </div>
            </div>

            <!-- Step 6: Official Enrolment -->
            <div class="col-lg-2 col-md-4 col-sm-6">
                <div class="p-3 rounded-3 border text-center h-100 @(isPortalActive ? "border-success" : "border-secondary")"
                     style="background: @(isPortalActive ? "rgba(16, 185, 129, 0.08)" : "var(--portal-surface-2)");">
                    <div class="mb-2">
                        @if (isPortalActive) { <i class="fa-solid fa-graduation-cap text-success fa-xl"></i> }
                        else { <i class="fa-solid fa-lock text-muted"></i> }
                    </div>
                    <div class="font-headings fw-bold small">6. Official Enrolment</div>
                    <div class="text-muted small" style="font-size:0.75rem;">
                        @(isPortalActive ? "Student ID Issued" : "Locked")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════ DIGITAL ADMIT SLIP (IF SCHEDULED) ═══════ -->
    @if (testSchedule != null)
    {
        <div class="portal-card mb-4 p-4 border-primary" style="background: rgba(37, 99, 235, 0.05);">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 bg-primary text-white fs-3" style="width:55px; height:55px; display:flex; align-items:center; justify-content:center;">
                            <i class="fa-solid fa-id-card-clip"></i>
                        </div>
                        <div>
                            <span class="badge bg-success font-headings mb-1"><i class="fa-solid fa-circle-check me-1"></i> Digital Admit Slip Ready</span>
                            <h5 class="font-headings fw-bold m-0">Admission Entry Test Scheduled</h5>
                            <div class="small text-muted mt-1">
                                Date: <strong class="text-primary">@testSchedule.TestDate.ToString("dd MMMM yyyy")</strong> | 
                                Time: <strong>@testSchedule.TestTime</strong> | 
                                Duration: <strong>@testSchedule.DurationHours Hours</strong><br />
                                Venue: <strong>@testSchedule.BuildingName, @testSchedule.RoomNumber (@testSchedule.CampusName)</strong> | 
                                Reporting Time: <strong>@testSchedule.ReportingTime</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <button type="button" onclick="window.print()" class="portal-btn portal-btn-primary portal-btn-sm">
                        <i class="fa-solid fa-print me-1"></i> Print Official Admit Slip
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ═══════ ENTRY TEST RESULT CARD (IF COMPLETED) ═══════ -->
    @if (testResult != null)
    {
        <div class="portal-card mb-4 p-4 @(testResult.IsQualified ? "border-success" : "border-danger")" style="background: rgba(16, 185, 129, 0.04);">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 @(testResult.IsQualified ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") fs-3" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-square-poll-vertical"></i>
                    </div>
                    <div>
                        <span class="badge @(testResult.IsQualified ? "bg-success" : "bg-danger") font-headings mb-1">
                            <i class="fa-solid @(testResult.IsQualified ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>
                            @(testResult.IsQualified ? "Entrance Test Qualified" : "Test Did Not Qualify")
                        </span>
                        <h5 class="font-headings fw-bold m-0">Entry Test Result &amp; Score Summary</h5>
                    </div>
                </div>
                <div class="text-end">
                    <div class="fs-4 text-primary font-headings fw-bold">@testResult.ObtainedMarks / @testResult.TotalMarks</div>
                    <div class="small text-muted font-headings">Score Percentage: @testResult.CalculatedPercentage%</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(testResult.Remarks))
            {
                <div class="p-3 rounded-3 small border" style="background: var(--portal-surface-2);">
                    <div class="text-primary fw-bold mb-1"><i class="fa-solid fa-comment-dots me-1"></i> Evaluation Remarks:</div>
                    <div>@testResult.Remarks</div>
                </div>
            }
        </div>
    }

    <!-- ═══════ OFFICIAL COMMITTEE REMARKS CARD ═══════ -->
    @if (latestApp != null && (!string.IsNullOrEmpty(latestApp.Remarks) || latestApp.CurrentStatus >= ApplicationStatus.Approved))
    {
        <div class="portal-card mb-4 p-4 border-success" style="background: rgba(16, 185, 129, 0.04);">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-3" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-certificate"></i>
                    </div>
                    <div>
                        <span class="badge bg-success font-headings mb-1"><i class="fa-solid fa-stamp me-1"></i> Official Decision</span>
                        <h5 class="font-headings fw-bold m-0">Admission Committee Decision Remarks</h5>
                    </div>
                </div>
                <span class="badge bg-success font-headings py-2 px-3">Status: @latestApp.CurrentStatus</span>
            </div>

            @if (!string.IsNullOrEmpty(latestApp.Remarks))
            {
                <div class="p-3 rounded-3 small border" style="background: var(--portal-surface-2);">
                    <div class="text-success fw-bold mb-1"><i class="fa-solid fa-quote-left me-1"></i> Committee Decision Comments:</div>
                    <div>@latestApp.Remarks</div>
                </div>
            }
        </div>
    }

    <!-- ═══════ FEE VOUCHERS SUMMARY SECTION ═══════ -->
    <div class="portal-card mb-4 p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-file-invoice-dollar text-primary fs-4"></i>
                <h5 class="font-headings fw-bold m-0">Admission Fee Vouchers &amp; Receipts</h5>
            </div>
            <a href="@Url.Action("FeeVouchers", "Admission")" class="portal-btn portal-btn-outline portal-btn-sm">
                <i class="fa-solid fa-receipt me-1"></i> Manage Payments &amp; Receipts
            </a>
        </div>

        <div class="row g-3">
            <!-- Stage 1: Processing Fee Voucher -->
            <div class="col-md-6">
                <div class="p-3 rounded-3 h-100 d-flex flex-column justify-content-between border" style="background: var(--portal-surface-2);">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary font-headings">Stage 1: Application Processing Fee</span>
                            @if (isProcessingFeePaid)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Paid &amp; Cleared</span>
                            }
                            else if (processingVoucher != null)
                            {
                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending Payment</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Unlocks on Form Submission</span>
                            }
                        </div>

                        <div class="h5 font-headings fw-bold m-0 text-success">PKR @(processingVoucher?.Amount.ToString("N0") ?? "2,500")</div>
                        <div class="small text-muted mt-1">
                            Voucher Reference: <strong>@(processingVoucher?.VoucherNumber ?? "Auto-Generated upon Submission")</strong>
                        </div>
                    </div>

                    <div class="mt-3 pt-2 border-top">
                        @if (isProcessingFeePaid)
                        {
                            <a href="@Url.Action("FeeVouchers", "Admission")" class="small fw-semibold text-success text-decoration-none">
                                <i class="fa-solid fa-circle-check me-1"></i> View Paid Fee Receipt
                            </a>
                        }
                        else if (processingVoucher != null)
                        {
                            <a href="@Url.Action("FeeVouchers", "Admission")" class="small fw-semibold text-warning text-decoration-none">
                                <i class="fa-solid fa-credit-card me-1"></i> Deposit Fee &amp; Upload Proof &rarr;
                            </a>
                        }
                        else
                        {
                            <span class="small text-muted">Complete your application form to generate this voucher.</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Stage 2: First Semester Tuition Fee Voucher -->
            <div class="col-md-6">
                <div class="p-3 rounded-3 h-100 d-flex flex-column justify-content-between border" style="background: var(--portal-surface-2);">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success bg-opacity-10 text-success font-headings">Stage 2: First Semester Tuition Fee</span>
                            @if (isSemesterFeePaid)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Paid &amp; Verified</span>
                            }
                            else if (semesterVoucher != null)
                            {
                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending Payment</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Locked (Awaiting Test Result)</span>
                            }
                        </div>

                        @if (semesterVoucher != null)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="h5 font-headings fw-bold m-0 text-success">PKR @semesterVoucher.NetPayableAmount.ToString("N0")</div>
                                @if (semesterVoucher.ScholarshipPercentageApplied > 0)
                                {
                                    <span class="badge bg-success font-headings"><i class="fa-solid fa-award me-1"></i> @semesterVoucher.ScholarshipPercentageApplied% Scholarship</span>
                                }
                            </div>
                            <div class="small text-muted mt-1">
                                Voucher No: <strong>@semesterVoucher.VoucherNumber</strong>
                            </div>
                        }
                        else
                        {
                            <div class="h5 font-headings fw-bold m-0 text-muted">PKR 65,000 (Approx)</div>
                            <div class="small text-muted mt-1">
                                1st Semester Fee Voucher unlocks automatically once your Entrance Test is cleared.
                            </div>
                        }
                    </div>

                    <div class="mt-3 pt-2 border-top">
                        @if (isSemesterFeePaid)
                        {
                            <a href="@Url.Action("FeeVouchers", "Admission")" class="small fw-semibold text-success text-decoration-none">
                                <i class="fa-solid fa-circle-check me-1"></i> View Tuition Fee Receipt
                            </a>
                        }
                        else if (semesterVoucher != null)
                        {
                            <a href="@Url.Action("FeeVouchers", "Admission")" class="small fw-semibold text-warning text-decoration-none">
                                <i class="fa-solid fa-credit-card me-1"></i> Pay Tuition Fee &amp; Reserve Seat &rarr;
                            </a>
                        }
                        else
                        {
                            <span class="small text-muted">Seat confirmation voucher unlocks upon entrance test merit.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════ QUICK SHORTCUTS GRID ═══════ -->
    <div class="row g-3">
        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("Documents", "Admission")" class="portal-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100 shadow-sm">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary fs-4" style="width:48px; height:48px; display:flex; align-items:center; justify-content:center;">
                    <i class="fa-solid fa-folder-open"></i>
                </div>
                <div>
                    <div class="font-headings fw-bold" style="color: var(--portal-text);">My Documents</div>
                    <div class="small text-muted">Upload or update files</div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("Profile", "Admission")" class="portal-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100 shadow-sm">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-4" style="width:48px; height:48px; display:flex; align-items:center; justify-content:center;">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <div class="font-headings fw-bold" style="color: var(--portal-text);">Applicant Profile</div>
                    <div class="small text-muted">Personal &amp; academics</div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("Messages", "Admission")" class="portal-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100 shadow-sm">
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info fs-4" style="width:48px; height:48px; display:flex; align-items:center; justify-content:center;">
                    <i class="fa-solid fa-envelope"></i>
                </div>
                <div>
                    <div class="font-headings fw-bold" style="color: var(--portal-text);">Messages &amp; Help</div>
                    <div class="small text-muted">Contact Admissions Desk</div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("StudentPortal", "Admission")" class="portal-card p-3 d-flex align-items-center gap-3 text-decoration-none h-100 shadow-sm">
                <div class="rounded-3 p-3 bg-purple bg-opacity-10 font-headings fs-4" style="color: #8b5cf6; width:48px; height:48px; display:flex; align-items:center; justify-content:center;">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <div class="font-headings fw-bold" style="color: var(--portal-text);">Student Portal</div>
                    <div class="small text-muted">Digital ID Card &amp; UMS</div>
                </div>
            </a>
        </div>
    </div>
</div>
