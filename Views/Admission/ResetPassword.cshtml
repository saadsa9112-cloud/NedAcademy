@inject NedAcademyWebsite.Services.ISettingService SettingService
@{
    Layout = null;
    var settings = await SettingService.GetSettingsAsync();
    string? email = ViewBag.Email as string;
    string? token = ViewBag.Token as string;
    string? errorMessage = ViewBag.ErrorMessage as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - @settings.UniversityName Applicant Portal</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Portal CSS -->
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
<body class="portal-auth-page">
    <div class="portal-auth-brand">
        <div class="portal-auth-brand-logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <h2>@settings.UniversityName</h2>
            <p>Applicant Portal</p>
        </div>
        <div class="portal-auth-brand-content">
            <h1>Set Your New<br><span>Secure Password</span></h1>
            <p class="portal-auth-brand-desc">Regain access to your applicant portal.</p>
            <ul class="portal-auth-features">
                <li><i class="fa-solid fa-check-circle"></i> Strong Encryption</li>
                <li><i class="fa-solid fa-check-circle"></i> Instant Update</li>
                <li><i class="fa-solid fa-check-circle"></i> Account Protection</li>
                <li><i class="fa-solid fa-check-circle"></i> Secure Verification</li>
            </ul>
            
            <div class="portal-auth-badges mt-5">
                <span class="badge bg-dark"><i class="fa-solid fa-shield-halved"></i> Secure Portal</span>
            </div>
        </div>
    </div>
    
    <div class="portal-register-form-panel">
        <div class="portal-auth-back">
            <a href="~/Admission/Login"><i class="fa-solid fa-arrow-left"></i> Back to Login</a>
        </div>
        
        <div class="portal-register-form-container" style="max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; justify-content: center; height: 100%;">
            <div class="portal-auth-form-header mb-4">
                <h2>Reset Password</h2>
                <p>Create a new secure password for your account</p>
            </div>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="portal-alert portal-alert-error mb-4 p-3 rounded bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @errorMessage
                </div>
            }
            
            <form asp-controller="Admission" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@email" />
                <input type="hidden" name="token" value="@token" />
                
                <div class="mb-4">
                    <label class="form-label">New Password</label>
                    <input type="password" name="newPassword" required class="portal-form-control" oninput="portalPasswordStrength(this)" placeholder="Enter new password" />
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" name="confirmPassword" required class="portal-form-control" placeholder="Re-enter new password" />
                </div>
                
                <div class="portal-password-strength mb-4 d-flex gap-1">
                    <span class="portal-password-bar flex-grow-1 bg-light rounded" style="height: 4px;"></span>
                    <span class="portal-password-bar flex-grow-1 bg-light rounded" style="height: 4px;"></span>
                    <span class="portal-password-bar flex-grow-1 bg-light rounded" style="height: 4px;"></span>
                    <span class="portal-password-bar flex-grow-1 bg-light rounded" style="height: 4px;"></span>
                    <span class="portal-password-bar flex-grow-1 bg-light rounded" style="height: 4px;"></span>
                </div>
                
                <button type="submit" class="portal-btn portal-btn-primary portal-btn-lg w-100 mb-4">
                    Reset Password
                </button>
                
                <div class="portal-auth-footer-text text-center">
                    <p>Remember your password? <a href="~/Admission/Login" class="text-primary fw-medium text-decoration-none">Sign In</a></p>
                </div>
            </form>
        </div>
    </div>
    
    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Portal JS -->
    <script src="~/js/portal.js" asp-append-version="true"></script>
    <!-- portalPasswordStrength is provided by portal.js -->
</body>
</html>
