@using NedAcademyWebsite.Models
@{
    Layout = "_ApplicantLayout";
    ViewData["Title"] = "Messages";

    var applicant = ViewBag.Applicant as Applicant;
    var messages = ViewBag.Messages as IEnumerable<ApplicantMessage> ?? new List<ApplicantMessage>();
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="portal-content-title">Communication Center</h1>
            <p class="portal-content-subtitle">Direct message history between you and the University Admission Desk.</p>
        </div>
        <button class="portal-btn portal-btn-cyan" data-bs-toggle="modal" data-bs-target="#newMessageModal">
            <i class="fa-solid fa-pen-to-square me-1"></i> Send New Message
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="portal-alert portal-alert-success mb-4">
            <i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Conversation Feed -->
    <div class="portal-card mb-4">
        <div class="portal-card-header">
            <div class="portal-card-title"><i class="fa-solid fa-comments me-2"></i> Message History</div>
        </div>
        <div class="portal-card-body">
            @if (messages.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var msg in messages)
                    {
                        bool isAdmin = msg.SenderType == "Admin";
                        <div class="portal-card p-3 @(isAdmin ? "border-cyan" : "")" style="background:@(isAdmin ? "rgba(0, 242, 254, 0.04)" : "var(--portal-surface)");">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="portal-badge @(isAdmin ? "portal-badge-active" : "portal-badge-info")">
                                        <i class="fa-solid @(isAdmin ? "fa-headset" : "fa-user") me-1"></i> @(msg.SenderName ?? msg.SenderType)
                                    </span>
                                    <h6 class="m-0 font-headings" style="font-weight:700; color:var(--portal-text);">@msg.Subject</h6>
                                </div>
                                <span style="font-size:0.78rem; color:var(--portal-text-muted);">@msg.SentAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                            <div style="font-size:0.88rem; color:var(--portal-text-secondary); line-height:1.7;">
                                @msg.MessageBody
                            </div>
                            @if (!string.IsNullOrEmpty(msg.AttachmentPath))
                            {
                                <div class="mt-2 pt-2 border-top border-white border-opacity-10">
                                    <a href="@msg.AttachmentPath" target="_blank" class="portal-btn portal-btn-ghost portal-btn-sm text-cyan">
                                        <i class="fa-solid fa-paperclip me-1"></i> View Attachment
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon"><i class="fa-solid fa-envelope-open-text"></i></div>
                    <div class="portal-empty-title">No Messages Yet</div>
                    <div class="portal-empty-desc mb-3">If you have any questions regarding your application, feel free to send a message directly to the Admission Office.</div>
                    <button class="portal-btn portal-btn-cyan" data-bs-toggle="modal" data-bs-target="#newMessageModal">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Compose Message
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Compose Message Modal -->
<div class="modal fade" id="newMessageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background:var(--portal-surface); border:1px solid var(--portal-border); color:var(--portal-text);">
            <div class="modal-header" style="border-bottom:1px solid var(--portal-border);">
                <h5 class="modal-title font-headings" style="font-size:1.1rem; font-weight:700;"><i class="fa-solid fa-paper-plane me-2 text-cyan"></i> Compose Message to Admission Office</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admission" asp-action="SendMessage" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="portal-form-label">Subject <span class="required">*</span></label>
                        <input type="text" name="subject" class="portal-form-control" placeholder="e.g. Inquiry regarding document verification status" required />
                    </div>
                    <div class="mb-3">
                        <label class="portal-form-label">Message Body <span class="required">*</span></label>
                        <textarea name="messageBody" rows="5" class="portal-form-control" placeholder="Type your message details here..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="portal-form-label">Attach File (Optional - PDF, JPG, PNG)</label>
                        <input type="file" name="attachment" class="portal-form-control" accept=".pdf,.jpg,.jpeg,.png" />
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--portal-border);">
                    <button type="button" class="portal-btn portal-btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="portal-btn portal-btn-cyan"><i class="fa-solid fa-paper-plane me-1"></i> Send Message</button>
                </div>
            </form>
        </div>
    </div>
</div>
