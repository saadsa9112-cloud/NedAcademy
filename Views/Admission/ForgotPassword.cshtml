@inject NedAcademyWebsite.Services.ISettingService SettingService
@{
    Layout = null;
    var settings = await SettingService.GetSettingsAsync();
    string? errorMessage = ViewBag.ErrorMessage as string;
    string? successMessage = ViewBag.SuccessMessage as string;
    string? resetToken = ViewBag.ResetToken as string;
    string? targetEmail = ViewBag.TargetEmail as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - @settings.UniversityName Applicant Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
<body>
    <div class="portal-auth-page">
        <!-- Left Panel -->
        <div class="portal-auth-brand">
            <div class="portal-auth-brand-logo">
                <div class="portal-auth-brand-icon">@(settings.UniversityName?.FirstOrDefault() ?? 'N')</div>
                <div class="portal-auth-brand-title">@settings.UniversityName</div>
                <div class="portal-auth-brand-subtitle">Applicant Portal</div>
            </div>
            
            <div class="portal-auth-brand-content">
                <h1 class="portal-auth-brand-heading">Recover Your<br><span>Portal Access</span></h1>
                <p class="portal-auth-brand-desc">Lost your password? No problem. Follow our secure process to quickly recover access to your admission portal.</p>
                
                <ul class="portal-auth-features">
                    <li class="portal-auth-feature">
                        <i class="fa-solid fa-shield-cat portal-auth-feature-icon"></i> Secure Reset Process
                    </li>
                    <li class="portal-auth-feature">
                        <i class="fa-regular fa-envelope-open portal-auth-feature-icon"></i> Email Verification
                    </li>
                    <li class="portal-auth-feature">
                        <i class="fa-solid fa-bolt portal-auth-feature-icon"></i> Instant Access Recovery
                    </li>
                    <li class="portal-auth-feature">
                        <i class="fa-solid fa-headset portal-auth-feature-icon"></i> 24/7 Support Available
                    </li>
                </ul>
            </div>
            
            <div class="portal-auth-badges">
                <div class="portal-auth-badge"><i class="fa-solid fa-lock"></i> 256-bit SSL</div>
                <div class="portal-auth-badge"><i class="fa-solid fa-shield-halved"></i> GDPR Compliant</div>
                <div class="portal-auth-badge"><i class="fa-solid fa-check-double"></i> Secure Portal</div>
            </div>
        </div>

        <!-- Right Panel -->
        <div class="portal-auth-form-panel">
            <a href="@Url.Action("Login", "Admission")" class="portal-auth-back">&larr; Back to Sign In</a>
            
            <div class="portal-auth-form-container">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="portal-alert portal-alert-error">
                        <i class="fa-solid fa-exclamation-circle"></i>
                        <span>@errorMessage</span>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="portal-alert portal-alert-success">
                        <i class="fa-solid fa-check-circle"></i>
                        <span>@successMessage</span>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(resetToken))
                {
                    <div class="portal-alert portal-alert-info">
                        <i class="fa-solid fa-info-circle"></i>
                        <span>
                            Development link: 
                            <a href="@Url.Action("ResetPassword", "Admission", new { email = targetEmail, token = resetToken })">Click here to reset your password</a>
                        </span>
                    </div>
                }

                <div class="portal-auth-form-header">
                    <h2 class="portal-auth-form-title">Forgot Password</h2>
                    <p class="portal-auth-form-subtitle">Enter your registered email to reset your password</p>
                </div>

                <form method="post" asp-controller="Admission" asp-action="ForgotPassword" asp-antiforgery="true">
                    <div class="portal-form-group">
                        <label class="portal-form-label">Email</label>
                        <input type="email" name="email" class="portal-form-control" required placeholder="name@example.com" />
                    </div>

                    <button type="submit" class="portal-btn portal-btn-primary portal-btn-lg" style="width:100%">
                        Send Reset Link <i class="fa-regular fa-paper-plane ms-2"></i>
                    </button>
                </form>

                <div class="portal-auth-footer-text text-center mt-4">
                    Remember your password? 
                    <a href="@Url.Action("Login", "Admission")" class="portal-auth-link">Sign In</a>
                </div>
            </div>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/portal.js" asp-append-version="true"></script>
</body>
</html>
