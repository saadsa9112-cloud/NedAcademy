@using NedAcademyWebsite.Models
@{
    Layout = "_ApplicantLayout";
    ViewData["Title"] = "Official Student Portal — Active Account";

    var applicant = ViewBag.Applicant as Applicant;
    var enrollment = ViewBag.EnrollmentRecord as EnrollmentRecord;
    var application = ViewBag.Application as AdmissionApplication;
}

<div class="container-fluid p-0">
    <!-- ═══════ CONGRATULATIONS BANNER ═══════ -->
    <div class="portal-alert portal-alert-success mb-4 p-3 d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(6, 182, 212, 0.2)); border: 1px solid var(--portal-green);">
        <div class="d-flex align-items-center gap-3">
            <div style="font-size: 2.2rem; color: var(--portal-green);">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <h5 class="fw-bold text-white mb-1 font-headings">Admission Confirmed & Official Student Credentials Issued</h5>
                <p class="small text-light mb-0">Your admission to <strong>@(enrollment?.DegreeProgram?.Name ?? application?.DegreeProgram?.Name ?? "Degree Program")</strong> has been officially confirmed and registered in the University Database.</p>
            </div>
        </div>
        <a href="@Url.Action("Dashboard", "Admission")" class="btn btn-sm btn-outline-light font-headings">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Admission Status Center
        </a>
    </div>

    <!-- ═══════ 3D DIGITAL STUDENT ID CARD SHOWCASE ═══════ -->
    <div class="row g-4 mb-5">
        <div class="col-lg-5 col-md-6">
            <div class="id-card-3d p-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(3, 7, 18, 0.98)); border: 2px solid var(--portal-cyan); border-radius: 20px; box-shadow: 0 20px 40px rgba(0, 242, 254, 0.15), 0 0 30px rgba(0,0,0,0.5); backdrop-filter: blur(15px);">
                <!-- Card Header -->
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-3 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-graduation-cap text-cyan fs-3"></i>
                        <div>
                            <div class="font-headings text-white fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.9rem;">NED ACADEMY</div>
                            <div class="text-cyan small" style="font-size: 0.7rem; text-transform: uppercase;">Official Student Identity Card</div>
                        </div>
                    </div>
                    <span class="badge bg-success font-headings px-2 py-1"><i class="fa-solid fa-shield-check me-1"></i> ACTIVE</span>
                </div>

                <!-- Card Body -->
                <div class="row align-items-center g-3">
                    <div class="col-4 text-center">
                        <div class="position-relative d-inline-block">
                            <img src="@(string.IsNullOrEmpty(applicant?.Profile?.ProfilePhotoPath) ? "/uploads/default_avatar.png" : applicant.Profile.ProfilePhotoPath)" 
                                 alt="Student Photo" 
                                 class="rounded-3 border border-cyan shadow" 
                                 style="width: 100px; height: 115px; object-fit: cover; background: #1e293b;" />
                            <span class="position-absolute bottom-0 end-0 bg-success rounded-circle p-1 border border-dark" title="Verified Record"></span>
                        </div>
                    </div>
                    <div class="col-8">
                        <h5 class="text-white font-headings fw-bold mb-1">@(applicant?.FullName ?? "Student Name")</h5>
                        <div class="text-cyan font-headings fw-bold mb-2" style="font-size:0.85rem;">@(enrollment?.DegreeProgram?.Name ?? application?.DegreeProgram?.Name ?? "BS SE")</div>

                        <div class="d-flex flex-column gap-1 small text-light">
                            <div>Student ID: <strong class="text-white">@(enrollment?.GeneratedStudentId ?? "STD-2026-00001")</strong></div>
                            <div>Roll Number: <strong class="text-white">@(enrollment?.GeneratedRollNumber ?? "2026-CS-001")</strong></div>
                            <div>Batch: <strong>@(enrollment?.Batch ?? "Fall 2026")</strong> | Semester: <strong>1st</strong></div>
                            <div>Department: <strong>Computer Science</strong></div>
                        </div>
                    </div>
                </div>

                <!-- Card Footer Barcode -->
                <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
                    <div style="font-family: monospace; letter-spacing: 3px; font-size: 0.85rem;" class="text-cyan">
                        ||| | |||| ||| || |||| ||
                    </div>
                    <div class="small text-muted font-headings" style="font-size: 0.65rem;">VALID: 2026 - 2030</div>
                </div>
            </div>
        </div>

        <!-- Right Side Credentials Summary -->
        <div class="col-lg-7 col-md-6 d-flex flex-column justify-content-center">
            <div class="portal-card p-4 h-100 d-flex flex-column justify-content-center border-start border-cyan border-4">
                <span class="portal-badge portal-badge-active mb-2 align-self-start"><i class="fa-solid fa-user-check me-1"></i> Account Provisioned</span>
                <h2 class="text-white font-headings fw-bold mb-2">Welcome to Your University Portal</h2>
                <p class="text-cyan mb-4">Your official University Management System (UMS) account has been created and synced with the academic registrar.</p>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded bg-dark bg-opacity-50 border border-secondary">
                            <div class="text-muted small">Registered Email</div>
                            <div class="text-white fw-bold text-truncate">@(applicant?.Email ?? "student@ned.edu.pk")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-dark bg-opacity-50 border border-secondary">
                            <div class="text-muted small">Department & Program</div>
                            <div class="text-white fw-bold text-truncate">Computer Science (BS SE)</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-dark bg-opacity-50 border border-secondary">
                            <div class="text-muted small">Issued Student ID</div>
                            <div class="text-cyan fw-bold">@(enrollment?.GeneratedStudentId ?? "STD-2026-00001")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-dark bg-opacity-50 border border-secondary">
                            <div class="text-muted small">Class Roll Number</div>
                            <div class="text-cyan fw-bold">@(enrollment?.GeneratedRollNumber ?? "2026-CS-001")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════ 3D UMS MODULES SHOWCASE (COMING SOON) ═══════ -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-white font-headings fw-bold m-0"><i class="fa-solid fa-cubes text-cyan me-2"></i>University Management System (UMS) Modules</h4>
            <p class="text-muted small m-0">The full UMS academic portal suite will be launched prior to class commencement.</p>
        </div>
        <span class="badge bg-warning text-dark font-headings px-3 py-2 fs-6"><i class="fa-solid fa-rocket me-1"></i> UMS Phase Launching Soon</span>
    </div>

    <div class="row g-4 mb-5">
        <!-- Module 1: LMS & Course Enrollment -->
        <div class="col-md-4">
            <div class="portal-card p-4 h-100 position-relative overflow-hidden ums-card-3d">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="portal-action-icon text-cyan" style="background: rgba(0, 242, 254, 0.1); width: 50px; height: 50px;">
                        <i class="fa-solid fa-book-bookmark fs-4"></i>
                    </div>
                    <span class="badge bg-secondary font-headings" style="font-size:0.65rem;">COMING SOON</span>
                </div>
                <h5 class="text-white font-headings fw-bold mb-2">LMS & Course Enrolment</h5>
                <p class="small text-muted mb-0">View 1st Semester enrolled courses, download syllabus slides, access lecture materials, and submit assignments online.</p>
            </div>
        </div>

        <!-- Module 2: Live Timetable & Schedule -->
        <div class="col-md-4">
            <div class="portal-card p-4 h-100 position-relative overflow-hidden ums-card-3d">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="portal-action-icon text-success" style="background: rgba(16, 185, 129, 0.1); width: 50px; height: 50px;">
                        <i class="fa-solid fa-calendar-week fs-4"></i>
                    </div>
                    <span class="badge bg-secondary font-headings" style="font-size:0.65rem;">COMING SOON</span>
                </div>
                <h5 class="text-white font-headings fw-bold mb-2">Interactive Class Timetable</h5>
                <p class="small text-muted mb-0">Real-time weekly class schedules, lecture hall allocations, faculty office hours, and lab timings.</p>
            </div>
        </div>

        <!-- Module 3: Attendance Tracking -->
        <div class="col-md-4">
            <div class="portal-card p-4 h-100 position-relative overflow-hidden ums-card-3d">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="portal-action-icon text-warning" style="background: rgba(245, 158, 11, 0.1); width: 50px; height: 50px;">
                        <i class="fa-solid fa-clipboard-user fs-4"></i>
                    </div>
                    <span class="badge bg-secondary font-headings" style="font-size:0.65rem;">COMING SOON</span>
                </div>
                <h5 class="text-white font-headings fw-bold mb-2">Attendance & Lecture Logs</h5>
                <p class="small text-muted mb-0">Real-time biometric attendance percentages, subject-wise attendance logs, and leave applications.</p>
            </div>
        </div>

        <!-- Module 4: Exams & Transcripts -->
        <div class="col-md-4">
            <div class="portal-card p-4 h-100 position-relative overflow-hidden ums-card-3d">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="portal-action-icon text-purple" style="background: rgba(139, 92, 246, 0.1); color:#8b5cf6; width: 50px; height: 50px;">
                        <i class="fa-solid fa-square-poll-vertical fs-4"></i>
                    </div>
                    <span class="badge bg-secondary font-headings" style="font-size:0.65rem;">COMING SOON</span>
                </div>
                <h5 class="text-white font-headings fw-bold mb-2">Exams & Semester Transcripts</h5>
                <p class="small text-muted mb-0">Midterm and Final Examination datesheets, GPA calculator, semester grade cards, and official transcripts.</p>
            </div>
        </div>

        <!-- Module 5: Student Finance Ledger -->
        <div class="col-md-4">
            <div class="portal-card p-4 h-100 position-relative overflow-hidden ums-card-3d">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="portal-action-icon text-cyan" style="background: rgba(0, 242, 254, 0.1); width: 50px; height: 50px;">
                        <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
                    </div>
                    <span class="badge bg-secondary font-headings" style="font-size:0.65rem;">COMING SOON</span>
                </div>
                <h5 class="text-white font-headings fw-bold mb-2">Student Finance & Dues Ledger</h5>
                <p class="small text-muted mb-0">Complete semester fee ledger, online tuition fee payment gateway, scholarship history, and financial clearance certificates.</p>
            </div>
        </div>

        <!-- Module 6: Library & Campus Services -->
        <div class="col-md-4">
            <div class="portal-card p-4 h-100 position-relative overflow-hidden ums-card-3d">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="portal-action-icon text-danger" style="background: rgba(239, 68, 68, 0.1); color:#ef4444; width: 50px; height: 50px;">
                        <i class="fa-solid fa-book-open-reader fs-4"></i>
                    </div>
                    <span class="badge bg-secondary font-headings" style="font-size:0.65rem;">COMING SOON</span>
                </div>
                <h5 class="text-white font-headings fw-bold mb-2">Digital Library & Campus Pass</h5>
                <p class="small text-muted mb-0">Access to IEEE/ACM digital library journals, book reservations, campus transport pass, and RFID gate pass.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .id-card-3d {
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }
    .id-card-3d:hover {
        transform: translateY(-8px) rotateX(4deg) rotateY(-4deg);
        box-shadow: 0 30px 60px rgba(0, 242, 254, 0.25), 0 0 40px rgba(0,0,0,0.8);
    }
    .ums-card-3d {
        transition: all 0.3s ease;
        border: 1px solid rgba(255,255,255,0.08);
    }
    .ums-card-3d:hover {
        transform: translateY(-5px);
        border-color: var(--portal-cyan);
        box-shadow: 0 10px 25px rgba(0, 242, 254, 0.15);
    }
</style>
