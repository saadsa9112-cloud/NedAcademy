<!-- ═══════ STYLES & SCRIPT FOR CARD FLIP & PRINTING ═══════ -->
<style>
    /* Card Flip Perspective */
    .card-flip-scene {
        perspective: 1200px;
        min-height: 250px;
    }
    .card-flip-inner {
        position: relative;
        width: 100%;
        transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
        transform-style: preserve-3d;
    }
    .card-flip-inner.is-flipped {
        transform: rotateY(180deg);
    }
    .card-face {
        width: 100%;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        border-radius: 14px;
    }
    .card-face-back {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        transform: rotateY(180deg);
    }

    /* Modern Crisp Student ID Card (University Standard) */
    .modern-id-card {
        background: #ffffff !important;
        border: 2px solid #2563eb;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.12), 0 4px 10px rgba(0,0,0,0.06);
        color: #0f172a;
    }

    /* Tabs Styling */
    .portal-nav-tabs .nav-link {
        color: var(--app-text-muted, #64748b);
        background: var(--app-surface-hover, #f1f5f9);
        border: 1px solid var(--app-border, #e2e8f0);
        border-radius: 8px;
        padding: 8px 16px;
        transition: all 0.15s ease;
    }
    .portal-nav-tabs .nav-link.active {
        background: #2563eb !important;
        color: #ffffff !important;
        border-color: #2563eb !important;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    /* Print Styles */
    @@media print {
        body * {
            visibility: hidden;
        }
        #printableCardFront, #printableCardFront *,
        #printableCardBack, #printableCardBack *,
        #printableOfferLetter, #printableOfferLetter * {
            visibility: visible;
        }
        #printableCardFront, #printableCardBack {
            position: absolute;
            left: 40px;
            top: 40px;
            width: 360px !important;
            margin-bottom: 25px;
            page-break-inside: avoid;
        }
        #printableOfferLetter {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
    }
</style>

<script>
    function toggleCardFlip() {
        var cardInner = document.getElementById('studentIdCardInner');
        if (cardInner) {
            cardInner.classList.toggle('is-flipped');
        }
    }

    function copyStudentId(id) {
        if (!id) return;
        navigator.clipboard.writeText(id).then(function () {
            alert('Student ID (' + id + ') copied to clipboard!');
        }).catch(function () {
            prompt('Student ID:', id);
        });
    }

    function printStudentIdCard() {
        window.print();
    }

    function printAdmissionLetter() {
        var letterContent = document.getElementById('printableOfferLetter');
        if (!letterContent) return;
        var printWindow = window.open('', '', 'width=900,height=700');
        printWindow.document.write('<html><head><title>Official Admission Offer Letter - NED Academy</title>');
        printWindow.document.write('<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css">');
        printWindow.document.write('<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">');
        printWindow.document.write('<style>body{padding:30px;font-family:Arial,sans-serif;}@@media print{body{padding:0;}}</style>');
        printWindow.document.write('</head><body>');
        printWindow.document.write(letterContent.innerHTML);
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        setTimeout(function () {
            printWindow.print();
            printWindow.close();
        }, 350);
    }
</script>