@using NedAcademyWebsite.Models
@{
    Layout = "_ApplicantLayout";
    bool isApproved = ViewBag.IsApprovedOrActive as bool? ?? false;
    ViewData["Title"] = isApproved ? "Official Student Portal — Active Account" : "Student Portal — Admission Progression";

    var applicant = ViewBag.Applicant as Applicant;
    var profile = ViewBag.ApplicantProfile as ApplicantProfile;
    var enrollment = ViewBag.EnrollmentRecord as EnrollmentRecord;
    var application = ViewBag.Application as AdmissionApplication;
    var testSchedule = ViewBag.TestSchedule as AdmissionTestSchedule;
    var testResult = ViewBag.TestResult as AdmissionTestResult;
    var documents = ViewBag.Documents as IEnumerable<ApplicationDocument> ?? new List<ApplicationDocument>();
    var timelineLogs = ViewBag.TimelineLogs as IEnumerable<ApplicationTimelineLog> ?? new List<ApplicationTimelineLog>();
    var vouchers = application?.FeeVouchers ?? new List<FeeVoucher>();
    var processingVoucher = vouchers.FirstOrDefault(v => v.VoucherType.Equals("ProcessingFee", StringComparison.OrdinalIgnoreCase));
    var semesterVoucher = vouchers.FirstOrDefault(v => v.VoucherType.Equals("FirstSemesterFee", StringComparison.OrdinalIgnoreCase) || v.VoucherType.Equals("AdmissionFee", StringComparison.OrdinalIgnoreCase));

    bool isProcessingFeePaid = processingVoucher != null && (processingVoucher.PaymentStatus == PaymentStatus.Paid || processingVoucher.VoucherStatus == VoucherStatus.Paid);
    bool hasPaidSemesterFee = semesterVoucher != null && (semesterVoucher.PaymentStatus == PaymentStatus.Paid || semesterVoucher.VoucherStatus == VoucherStatus.Paid);
    bool isDocsVerified = documents.Any() && documents.All(d => d.VerificationStatus == DocumentVerificationStatus.Verified);
    bool isTestQualified = testResult != null && testResult.IsQualified;

    string programName = enrollment?.DegreeProgram?.Name ?? application?.DegreeProgram?.Name ?? "Computer Science & Information Technology";
    string studentId = enrollment?.GeneratedStudentId ?? $"STD-2026-{(applicant?.Id ?? 1):D5}";
    string rollNo = enrollment?.GeneratedRollNumber ?? $"2026-CS-{(application?.Id ?? 1):D3}";
    string batchName = enrollment?.Batch ?? "Spring Batch 2026";
    string departmentName = enrollment?.Department?.Name ?? "Department of Computer Science & Software Engineering";
}

<div class="container-fluid p-0">
    <!-- ═══════ TOP STUDENT WELCOME BANNER ═══════ -->
    <div class="portal-card p-4 mb-4" style="background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(5, 150, 105, 0.08) 100%); border-left: 5px solid var(--app-primary, #2563eb);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white font-headings fw-bold shadow-sm"
                     style="width: 54px; height: 54px; background: linear-gradient(135deg, #2563eb, #059669); font-size: 1.4rem;">
                    @((applicant?.FullName ?? "S")[0])
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        @if (isApproved)
                        {
                            <span class="badge bg-success font-headings px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> ENROLLED &amp; ACTIVE</span>
                            <span class="badge bg-primary font-headings px-2 py-1"><i class="fa-solid fa-id-card me-1"></i> @studentId</span>
                            <span class="badge bg-secondary font-headings px-2 py-1">Roll No: @rollNo</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark font-headings px-2 py-1"><i class="fa-solid fa-clock me-1"></i> ADMISSION IN PROGRESS</span>
                            <span class="badge bg-secondary font-headings px-2 py-1">App: @(application?.ApplicationNumber ?? "Draft")</span>
                        }
                    </div>
                    <h2 class="portal-content-title mb-1">@(applicant?.FullName ?? "Student Name")</h2>
                    <p class="text-muted small mb-0">
                        Program: <strong class="text-primary">@programName</strong> | Department: <strong>@departmentName</strong> | Batch: <strong>@batchName</strong>
                    </p>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (isApproved)
                {
                    <button type="button" onclick="printStudentIdCard()" class="btn btn-primary font-headings px-3 py-2 shadow-sm">
                        <i class="fa-solid fa-print me-1"></i> Print Student ID Card
                    </button>
                    <button type="button" class="btn btn-outline-secondary font-headings px-3 py-2" data-bs-toggle="modal" data-bs-target="#admissionOfferLetterModal">
                        <i class="fa-solid fa-file-contract me-1"></i> Admission Offer Letter
                    </button>
                }
                <a href="@Url.Action("Dashboard", "Admission")" class="btn btn-outline-primary font-headings px-3 py-2">
                    <i class="fa-solid fa-gauge-high me-1"></i> Admission Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- ═══════ STEP-BY-STEP ADMISSION-TO-STUDENT PROGRESSION BAR ═══════ -->
    <div class="portal-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="font-headings fw-bold m-0"><i class="fa-solid fa-route text-primary me-2"></i> Admission to Student Journey</h5>
            <span class="badge @(isApproved ? "bg-success" : "bg-primary") font-headings">
                @(isApproved ? "Journey Completed (100%)" : "In Progress (Step 4 of 5)")
            </span>
        </div>

        <div class="row g-2 text-center">
            <!-- Step 1: Application -->
            <div class="col">
                <div class="p-3 rounded-3 h-100 border @(application != null ? "border-success bg-success bg-opacity-10" : "border-secondary")">
                    <div class="rounded-circle d-inline-flex p-2 @(application != null ? "text-success bg-success bg-opacity-25" : "text-muted bg-secondary bg-opacity-10") mb-2">
                        <i class="fa-solid @(application != null ? "fa-circle-check" : "fa-file-lines") fa-lg"></i>
                    </div>
                    <div class="font-headings fw-bold small">1. Form Submitted</div>
                    <div class="text-muted" style="font-size:0.7rem;">Application #@(application?.ApplicationNumber ?? "Pending")</div>
                </div>
            </div>

            <!-- Step 2: Documents -->
            <div class="col">
                <div class="p-3 rounded-3 h-100 border @(isDocsVerified ? "border-success bg-success bg-opacity-10" : "border-secondary")">
                    <div class="rounded-circle d-inline-flex p-2 @(isDocsVerified ? "text-success bg-success bg-opacity-25" : "text-muted bg-secondary bg-opacity-10") mb-2">
                        <i class="fa-solid @(isDocsVerified ? "fa-circle-check" : "fa-folder-check") fa-lg"></i>
                    </div>
                    <div class="font-headings fw-bold small">2. Scrutiny Cleared</div>
                    <div class="text-muted" style="font-size:0.7rem;">Verified Documents</div>
                </div>
            </div>

            <!-- Step 3: Test & Merit -->
            <div class="col">
                <div class="p-3 rounded-3 h-100 border @(isTestQualified ? "border-success bg-success bg-opacity-10" : "border-secondary")">
                    <div class="rounded-circle d-inline-flex p-2 @(isTestQualified ? "text-success bg-success bg-opacity-25" : "text-muted bg-secondary bg-opacity-10") mb-2">
                        <i class="fa-solid @(isTestQualified ? "fa-circle-check" : "fa-clipboard-check") fa-lg"></i>
                    </div>
                    <div class="font-headings fw-bold small">3. Entrance Test</div>
                    <div class="text-muted" style="font-size:0.7rem;">
                        @(testResult != null ? $"{testResult.ObtainedMarks}/{testResult.TotalMarks} ({testResult.CalculatedPercentage}%)" : "Passed")
                    </div>
                </div>
            </div>

            <!-- Step 4: Fee Voucher -->
            <div class="col">
                <div class="p-3 rounded-3 h-100 border @(hasPaidSemesterFee ? "border-success bg-success bg-opacity-10" : "border-warning bg-warning bg-opacity-10")">
                    <div class="rounded-circle d-inline-flex p-2 @(hasPaidSemesterFee ? "text-success bg-success bg-opacity-25" : "text-warning bg-warning bg-opacity-25") mb-2">
                        <i class="fa-solid @(hasPaidSemesterFee ? "fa-circle-check" : "fa-receipt") fa-lg"></i>
                    </div>
                    <div class="font-headings fw-bold small">4. Tuition Fee</div>
                    <div class="text-muted" style="font-size:0.7rem;">
                        @(hasPaidSemesterFee ? "Paid & Verified" : "Pending Deposit")
                    </div>
                </div>
            </div>

            <!-- Step 5: Official Enrollment -->
            <div class="col">
                <div class="p-3 rounded-3 h-100 border @(isApproved ? "border-success bg-success bg-opacity-10" : "border-secondary")">
                    <div class="rounded-circle d-inline-flex p-2 @(isApproved ? "text-success bg-success bg-opacity-25" : "text-muted bg-secondary bg-opacity-10") mb-2">
                        <i class="fa-solid @(isApproved ? "fa-graduation-cap" : "fa-lock") fa-lg"></i>
                    </div>
                    <div class="font-headings fw-bold small">5. Enrolled &amp; Active</div>
                    <div class="text-muted" style="font-size:0.7rem;">
                        @(isApproved ? $"ID: {studentId}" : "Awaiting Approval")
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isApproved)
    {
        <!-- ═══════ STUDENT ID CARD & QUICK PROFILE ROW ═══════ -->
        <div class="row g-4 mb-4">
            <!-- Digital Student ID Card -->
            <div class="col-lg-5 col-md-12">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small font-headings"><i class="fa-solid fa-id-card text-primary me-1"></i> Official Student Identity Card</span>
                    <button type="button" class="btn btn-sm btn-outline-primary font-headings" onclick="toggleCardFlip()">
                        <i class="fa-solid fa-rotate me-1"></i> Flip Card (Front/Back)
                    </button>
                </div>

                <!-- Card Flip Perspective Container -->
                <div class="card-flip-scene">
                    <div class="card-flip-inner" id="studentIdCardInner">
                        <!-- ══════ CARD FRONT ══════ -->
                        <div class="card-face card-face-front modern-id-card p-4 position-relative overflow-hidden" id="printableCardFront">
                            <!-- Card Header -->
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle p-2 bg-primary text-white">
                                        <i class="fa-solid fa-university fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="font-headings fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem; color:#0f172a;">NED UNIVERSITY</div>
                                        <div class="text-primary small fw-semibold" style="font-size: 0.65rem; text-transform: uppercase;">NED ACADEMY — STUDENT ID</div>
                                    </div>
                                </div>
                                <span class="badge bg-success font-headings px-2 py-1"><i class="fa-solid fa-shield-check me-1"></i> ACTIVE</span>
                            </div>

                            <!-- Card Body -->
                            <div class="row align-items-center g-3">
                                <div class="col-4 text-center">
                                    <div class="position-relative d-inline-block">
                                        <img src="@(string.IsNullOrEmpty(profile?.ProfilePhotoPath) ? "/uploads/default_avatar.png" : profile.ProfilePhotoPath)" 
                                             alt="Student Photo" 
                                             class="rounded-3 border border-2 border-primary shadow-sm" 
                                             style="width: 100px; height: 120px; object-fit: cover; background: #e2e8f0;" />
                                    </div>
                                    <div class="mt-1 badge bg-light text-dark border" style="font-size:0.6rem;">VALID: 2026 - 2030</div>
                                </div>
                                <div class="col-8">
                                    <h5 class="font-headings fw-bold mb-1 text-truncate" style="color:#0f172a;">@(applicant?.FullName ?? "Student Name")</h5>
                                    <div class="text-primary font-headings fw-bold mb-2" style="font-size:0.85rem;">@programName</div>

                                    <div class="d-flex flex-column gap-1 small font-monospace" style="font-size: 0.78rem; color:#334155;">
                                        <div><span class="text-muted">Student ID:</span> <strong style="color:#0f172a;">@studentId</strong></div>
                                        <div><span class="text-muted">Roll No:</span> <strong style="color:#0f172a;">@rollNo</strong></div>
                                        <div><span class="text-muted">Batch:</span> <strong>@batchName</strong></div>
                                        <div><span class="text-muted">Semester:</span> <strong class="text-primary">1st (Spring 2026)</strong></div>
                                        <div><span class="text-muted">Dept:</span> Computer Science &amp; AI</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Footer Barcode & Signature -->
                            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-microchip text-warning fs-4" title="Smart Card RFID Chip"></i>
                                    <div style="font-family: monospace; letter-spacing: 3px; font-size: 0.85rem; color:#0f172a;">
                                        ||| |||| ||||| |||| || |||
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted font-headings" style="font-size: 0.65rem;">AUTHORIZED SIGNATURE</div>
                                    <div class="text-primary font-monospace small" style="font-size: 0.65rem;">REGISTRAR / ADMISSIONS</div>
                                </div>
                            </div>
                        </div>

                        <!-- ══════ CARD BACK ══════ -->
                        <div class="card-face card-face-back modern-id-card p-4 position-relative overflow-hidden" id="printableCardBack">
                            <!-- Back Header -->
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-address-card text-primary fs-5"></i>
                                    <span class="font-headings fw-bold small text-uppercase" style="color:#0f172a;">Cardholder Verification Data</span>
                                </div>
                                <span class="badge bg-secondary font-headings" style="font-size: 0.6rem;">OFFICIAL PROPERTY</span>
                            </div>

                            <!-- Back Body Details -->
                            <div class="small font-monospace d-flex flex-column gap-2 mb-3" style="font-size: 0.75rem; color:#334155;">
                                <div><span class="text-muted">Father / Guardian:</span> <strong>@(profile?.FatherName ?? "Guardian Name")</strong></div>
                                <div><span class="text-muted">CNIC / Passport:</span> <strong>@(applicant?.CNIC_Passport ?? "42101-XXXXXXX-X")</strong></div>
                                <div><span class="text-muted">Emergency Contact:</span> <strong>@(applicant?.PhoneNumber ?? "+92 300 1234567")</strong></div>
                                <div><span class="text-muted">Blood Group:</span> <span class="badge bg-danger">B+</span> | <span class="text-muted">Domicile:</span> @(profile?.Domicile ?? "Karachi (Urban)")</div>
                                <div><span class="text-muted">Campus Address:</span> University Road, Karachi - 75270</div>
                            </div>

                            <!-- Rules & Disclaimer -->
                            <div class="p-2 rounded bg-light border mb-3" style="font-size: 0.62rem; color: #64748b; line-height: 1.3;">
                                1. This card is non-transferable and remains university property.<br />
                                2. Must be presented upon request at campus entry, exams, and library.<br />
                                3. If found, return to NED Academy Student Affairs Desk.
                            </div>

                            <!-- Back Footer Signature & Seal -->
                            <div class="d-flex justify-content-between align-items-center border-top pt-2">
                                <div>
                                    <div class="text-primary small fw-bold font-headings" style="font-size: 0.65rem;">NED ACADEMY SECURITY</div>
                                    <div class="text-muted" style="font-size: 0.6rem;">Issue: Jan 2026 | Exp: Dec 2030</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success font-headings" style="font-size: 0.65rem;">
                                        <i class="fa-solid fa-stamp me-1"></i> VERIFIED REGISTRAR SEAL
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card Controls Bar -->
                <div class="d-flex align-items-center justify-content-center gap-2 mt-3 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary font-headings px-3" onclick="copyStudentId('@studentId')">
                        <i class="fa-solid fa-copy me-1"></i> Copy Student ID
                    </button>
                    <button type="button" class="btn btn-sm btn-primary font-headings px-3 shadow-sm" onclick="printStudentIdCard()">
                        <i class="fa-solid fa-print me-1"></i> Print Physical Card
                    </button>
                </div>
            </div>

            <!-- Enrolled Status & Fee Clearance Summary Card -->
            <div class="col-lg-7 col-md-12">
                <div class="portal-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-success bg-opacity-10 text-success font-headings px-2 py-1">
                                <i class="fa-solid fa-shield-halved me-1"></i> Academic Record Active
                            </span>
                            <span class="text-muted small font-headings">Academic Session 2026-2027</span>
                        </div>
                        <h4 class="font-headings fw-bold mb-2">Welcome to University Academic Management</h4>
                        <p class="text-muted small mb-4">Your official student record is synchronized with the Academic Registrar, LMS Engine, and Examination Cell.</p>

                        <!-- Tuition Fee Clearance Card -->
                        <div class="p-3 rounded-3 mb-4" style="background: var(--app-surface-hover, #f8fafc); border: 1px solid var(--app-border, #e2e8f0);">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small font-headings"><i class="fa-solid fa-receipt text-success me-1"></i> 1st Semester Tuition Fee Voucher</span>
                                <span class="badge bg-success font-headings"><i class="fa-solid fa-check me-1"></i> PAID &amp; CLEARED</span>
                            </div>
                            <div class="row g-2 small">
                                <div class="col-sm-4">
                                    <div class="text-muted">Voucher Amount:</div>
                                    <div class="fw-bold text-success fs-6">Rs. 65,000</div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="text-muted">Challan / Ref No:</div>
                                    <div class="fw-bold font-monospace">@(semesterVoucher?.VoucherNumber ?? "VCH-2026-0819")</div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="text-muted">Payment Channel:</div>
                                    <div class="fw-bold">1Link / Habib Bank Ltd</div>
                                </div>
                            </div>
                        </div>

                        <!-- Credentials Grid -->
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3" style="background: var(--app-surface-hover, #f8fafc); border: 1px solid var(--app-border, #e2e8f0);">
                                    <div class="text-muted small">Registered Student Email</div>
                                    <div class="fw-bold text-truncate">@(applicant?.Email ?? "student@ned.edu.pk")</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3" style="background: var(--app-surface-hover, #f8fafc); border: 1px solid var(--app-border, #e2e8f0);">
                                    <div class="text-muted small">Academic Department</div>
                                    <div class="fw-bold text-truncate">@departmentName</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Admission Offer Letter Quick Access -->
                    <div class="p-3 rounded-3 mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="background: rgba(37, 99, 235, 0.05); border: 1px solid rgba(37, 99, 235, 0.2);">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-file-circle-check text-primary fs-4"></i>
                            <div>
                                <div class="font-headings fw-bold small">Official Admission Confirmation Package</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Admission Offer Letter &amp; Orientation Guidelines.</div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary font-headings px-3" data-bs-toggle="modal" data-bs-target="#admissionOfferLetterModal">
                            <i class="fa-solid fa-eye me-1"></i> View Letter &amp; PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════ UMS INTERACTIVE WORKSPACE TABS ═══════ -->
        <div class="portal-card mb-4 p-4">
            <!-- Nav Tabs -->
            <ul class="nav nav-pills portal-nav-tabs mb-4 flex-wrap gap-2" id="umsPortalTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active font-headings" id="courses-tab" data-bs-toggle="pill" data-bs-target="#courses-pane" type="button" role="tab">
                        <i class="fa-solid fa-book-bookmark me-1"></i> LMS &amp; Enrolled Courses
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link font-headings" id="timetable-tab" data-bs-toggle="pill" data-bs-target="#timetable-pane" type="button" role="tab">
                        <i class="fa-solid fa-calendar-week me-1"></i> Weekly Class Timetable
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link font-headings" id="finance-tab" data-bs-toggle="pill" data-bs-target="#finance-pane" type="button" role="tab">
                        <i class="fa-solid fa-receipt me-1"></i> Fee Ledger &amp; Receipts
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link font-headings" id="calendar-tab" data-bs-toggle="pill" data-bs-target="#calendar-pane" type="button" role="tab">
                        <i class="fa-solid fa-calendar-day me-1"></i> Academic Calendar
                    </button>
                </li>
            </ul>

            <!-- Tab Panes Content -->
            <div class="tab-content" id="umsPortalTabsContent">
                <!-- ══════ TAB 1: COURSES & LMS ══════ -->
                <div class="tab-pane fade show active" id="courses-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="font-headings fw-bold m-0"><i class="fa-solid fa-graduation-cap text-primary me-2"></i> 1st Semester Auto-Registered Courses</h5>
                            <p class="text-muted small m-0">Curriculum registered by Academic Registrar for Batch 2026.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary font-headings">Total: 5 Courses (17 Credit Hours)</span>
                            <span class="badge bg-success font-headings">Confirmed</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6 col-lg-4">
                            <div class="p-3 rounded-3 border h-100 d-flex flex-column justify-content-between" style="background: var(--app-surface-hover, #f8fafc);">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary bg-opacity-10 text-primary font-monospace">CS-101</span>
                                        <span class="small text-muted font-headings">3 + 1 Cr. Hrs</span>
                                    </div>
                                    <h6 class="font-headings fw-bold mb-1">Fundamentals of Computer Programming</h6>
                                    <div class="small text-muted mb-2"><i class="fa-solid fa-chalkboard-user me-1"></i> Dr. Farooq / Engr. Bilal</div>
                                    <div class="small text-muted"><i class="fa-solid fa-location-dot text-primary me-1"></i> CS Lab 1 &amp; Main Hall B</div>
                                </div>
                                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success bg-opacity-10 text-success">Active Enrolment</span>
