@model IEnumerable<NedAcademyWebsite.Models.ContactMessage>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Executive System Dashboard";
    var recentLogs = (List<NedAcademyWebsite.Models.AuditLog>)ViewBag.RecentLogs;
    var recentUploads = (List<NedAcademyWebsite.Models.MediaAsset>)ViewBag.RecentUploads;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary bg-opacity-10 text-primary font-headings px-2 py-1" style="font-size:0.75rem;">
                <i class="fa-solid fa-server me-1"></i> NED ENTERPRISE ARCHITECTURE
            </span>
            <span class="badge bg-success bg-opacity-10 text-success font-headings px-2 py-1" style="font-size:0.75rem;">
                <i class="fa-solid fa-circle-check me-1"></i> Subsystems Active
            </span>
        </div>
        <h2 class="font-headings fw-bold mb-1">Executive Control &amp; Portal Hub</h2>
        <p class="text-muted mb-0 small">Enterprise switcher connecting Academic Registry (UMS), Admission ERP, and Web Content CMS.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-modern-outline btn-sm font-headings">
            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View Live Site
        </a>
    </div>
</div>

<!-- ═══════ ENTERPRISE SUITE WORKSPACE LAUNCHPAD ═══════ -->
<div class="row g-4 mb-5">
    <!-- 1. Academic Registry & UMS -->
    <div class="col-xl-4 col-md-6">
        <div class="app-card p-4 h-100 d-flex flex-column justify-content-between" style="border-top: 4px solid var(--app-emerald);">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-success bg-opacity-10 text-success font-headings px-2 py-1">
                        <i class="fa-solid fa-graduation-cap me-1"></i> ACADEMIC REGISTRY (UMS)
                    </span>
                    <span class="badge bg-secondary bg-opacity-10 text-muted">@ViewBag.EnrolledStudentsCount Students</span>
                </div>
                <h4 class="font-headings fw-bold mb-2">University Registrar &amp; UMS</h4>
                <p class="text-muted small mb-3">Enrolled student directory, student identity records, degree program catalogs, departments, and faculty roster.</p>
                
                <div class="p-3 rounded-3 mb-3" style="background: var(--app-surface-hover); border: 1px solid var(--app-border);">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Degree Programs:</span>
                        <span class="fw-bold">@ViewBag.ProgramsCount</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Faculty Members:</span>
                        <span class="fw-bold">@ViewBag.FacultyCount</span>
                    </div>
                </div>
            </div>
            <a href="/UMS" class="btn btn-modern-primary w-100 font-headings text-center mt-2" style="background: var(--app-emerald); border-color: var(--app-emerald);">
                <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Launch Academic UMS
            </a>
        </div>
    </div>

    <!-- 2. Admission ERP -->
    <div class="col-xl-4 col-md-6">
        <div class="app-card p-4 h-100 d-flex flex-column justify-content-between" style="border-top: 4px solid var(--app-primary);">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary font-headings px-2 py-1">
                        <i class="fa-solid fa-id-card-clip me-1"></i> ADMISSION ERP
                    </span>
                    <span class="badge bg-secondary bg-opacity-10 text-muted">@ViewBag.ApplicationsCount Applications</span>
                </div>
                <h4 class="font-headings fw-bold mb-2">Admissions Directorate</h4>
                <p class="text-muted small mb-3">Applicant scrutiny queue, entrance test scheduling, fee voucher clearances &amp; decision committee.</p>
                
                <div class="p-3 rounded-3 mb-3" style="background: var(--app-surface-hover); border: 1px solid var(--app-border);">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Pending Review:</span>
                        <span class="fw-bold text-warning">@ViewBag.PendingApplicationsCount</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Scholarships &amp; Vouchers:</span>
                        <span class="fw-bold text-success">Automated</span>
                    </div>
                </div>
            </div>
            <a href="/Admissions" class="btn btn-modern-primary w-100 font-headings text-center mt-2">
                <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Launch Admission ERP
            </a>
        </div>
    </div>

    <!-- 3. Web CMS & Content Engine -->
    <div class="col-xl-4 col-md-6">
        <div class="app-card p-4 h-100 d-flex flex-column justify-content-between" style="border-top: 4px solid var(--app-purple);">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-purple bg-opacity-10 font-headings px-2 py-1" style="color: var(--app-purple);">
                        <i class="fa-solid fa-globe me-1"></i> WEB CMS PORTAL
                    </span>
                    <span class="badge bg-secondary bg-opacity-10 text-muted">@ViewBag.MediaAssetsCount Assets</span>
                </div>
                <h4 class="font-headings fw-bold mb-2">Digital Media &amp; CMS</h4>
                <p class="text-muted small mb-3">Visual page builder, dynamic forms, announcements, news publisher, facilities, and public inquiries inbox.</p>
                
                <div class="p-3 rounded-3 mb-3" style="background: var(--app-surface-hover); border: 1px solid var(--app-border);">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Public Inquiries:</span>
                        <span class="fw-bold">@ViewBag.MessagesCount</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Downloads Available:</span>
                        <span class="fw-bold">@ViewBag.DownloadsCount</span>
                    </div>
                </div>
            </div>
            <a href="/CMS" class="btn btn-modern-primary w-100 font-headings text-center mt-2" style="background: var(--app-purple); border-color: var(--app-purple);">
                <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Launch Web CMS
            </a>
        </div>
    </div>
</div>

<!-- ═══════ KEY METRICS ROW ═══════ -->
<div class="row g-4 mb-5">
    <div class="col-xl-3 col-sm-6">
        <div class="app-card p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase font-headings fw-bold">Enrolled Students</span>
                    <h3 class="font-headings fw-bold mt-1 mb-0">@ViewBag.EnrolledStudentsCount</h3>
                </div>
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-user-graduate fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-sm-6">
        <div class="app-card p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase font-headings fw-bold">Academic Programs</span>
                    <h3 class="font-headings fw-bold mt-1 mb-0">@ViewBag.ProgramsCount</h3>
                </div>
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-book-open fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="app-card p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase font-headings fw-bold">Faculty Members</span>
                    <h3 class="font-headings fw-bold mt-1 mb-0">@ViewBag.FacultyCount</h3>
                </div>
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-chalkboard-user fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="app-card p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase font-headings fw-bold">Public Inquiries</span>
                    <h3 class="font-headings fw-bold mt-1 mb-0">@ViewBag.MessagesCount</h3>
                </div>
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning">
                    <i class="fa-solid fa-envelope fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════ RECENT AUDIT LOGS & SYSTEM ACTIVITY ═══════ -->
<div class="row g-4 mb-4">
    <!-- Audit Activity Stream -->
    <div class="col-lg-8">
        <div class="app-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-headings fw-bold m-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> Recent System Activity</h5>
                <a asp-action="AuditLogs" class="small text-decoration-none fw-semibold">View All Logs &rarr;</a>
            </div>
            
            @if (recentLogs != null && recentLogs.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Details</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in recentLogs.Take(6))
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary font-headings px-2 py-1">@log.Action</span>
                                    </td>
                                    <td class="fw-semibold">@log.EntityName</td>
                                    <td class="text-muted small">@log.Details</td>
                                    <td class="text-muted small">@log.Timestamp.ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-clipboard-check fa-2x mb-2 opacity-50"></i>
                    <p class="small mb-0">No recent administrative logs found.</p>
                </div>
            }
        </div>
    </div>

    <!-- Quick Governance Settings -->
    <div class="col-lg-4">
        <div class="app-card p-4 h-100">
            <h5 class="font-headings fw-bold mb-3"><i class="fa-solid fa-shield-halved text-success me-2"></i> System Health &amp; Security</h5>
            
            <div class="p-3 rounded-3 mb-3" style="background: var(--app-surface-hover); border: 1px solid var(--app-border);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Core Framework</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary font-headings">.NET 10.0 MVC</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Database Engine</span>
                    <span class="badge bg-secondary bg-opacity-10 text-muted font-headings">SQL Server EF Core</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Security Architecture</span>
                    <span class="badge bg-success bg-opacity-10 text-success font-headings">Encrypted Session</span>
                </div>
            </div>

            <div class="d-grid gap-2">
                <a asp-action="Settings" asp-route-workspace="system" class="btn btn-modern-outline btn-sm font-headings">
                    <i class="fa-solid fa-sliders me-1"></i> Global Settings
                </a>
                <a asp-action="Backups" asp-route-workspace="system" class="btn btn-modern-outline btn-sm font-headings">
                    <i class="fa-solid fa-database me-1"></i> Database Backups
                </a>
                <a asp-action="RecycleBin" asp-route-workspace="system" class="btn btn-modern-outline btn-sm font-headings text-danger">
                    <i class="fa-solid fa-trash-can me-1"></i> Recycle Bin
                </a>
            </div>
        </div>
    </div>
</div>