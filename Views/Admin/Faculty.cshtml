@model IEnumerable<NedAcademyWebsite.Models.Faculty>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Faculty Directory";
    var depts = ViewBag.Departments as List<NedAcademyWebsite.Models.Department> ?? new List<NedAcademyWebsite.Models.Department>();
}

<div class="d-flex justify-content-between align-items-center mb-4 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Faculty Directory</h1>
        <p class="text-muted m-0">Manage university academic profiles, qualifications, research areas, and designations.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-cyber font-headings px-4 py-2" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fa-solid fa-plus me-1"></i> Add Faculty
        </button>
    </div>
</div>

<!-- Metrics Cards Bar -->
<div class="row g-3 mb-4 reveal-up">
    <div class="col-md-3">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between" style="border-left: 4px solid var(--cyan);">
            <div>
                <small class="text-muted text-uppercase font-headings" style="font-size:0.7rem; font-weight:700;">Total Faculty</small>
                <h3 class="text-white font-headings fw-bold m-0">@Model.Count()</h3>
            </div>
            <i class="fa-solid fa-users-line fa-2x text-gradient-cyan"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between" style="border-left: 4px solid var(--royal-blue);">
            <div>
                <small class="text-muted text-uppercase font-headings" style="font-size:0.7rem; font-weight:700;">Ph.D. Scholars</small>
                <h3 class="text-white font-headings fw-bold m-0">@Model.Count(f => f.Qualification.Contains("Ph.D"))</h3>
            </div>
            <i class="fa-solid fa-award fa-2x text-gradient-blue"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between" style="border-left: 4px solid var(--cyan);">
            <div>
                <small class="text-muted text-uppercase font-headings" style="font-size:0.7rem; font-weight:700;">Professors / Deans</small>
                <h3 class="text-white font-headings fw-bold m-0">@Model.Count(f => f.Designation.Contains("Professor") || f.Designation.Contains("Dean"))</h3>
            </div>
            <i class="fa-solid fa-user-tie fa-2x text-gradient-cyan"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between" style="border-left: 4px solid var(--royal-blue);">
            <div>
                <small class="text-muted text-uppercase font-headings" style="font-size:0.7rem; font-weight:700;">Departments</small>
                <h3 class="text-white font-headings fw-bold m-0">@depts.Count</h3>
            </div>
            <i class="fa-solid fa-sitemap fa-2x text-gradient-blue"></i>
        </div>
    </div>
</div>

<!-- Search & Dual View Toggle Bar -->
<div class="glass-card p-3 mb-4 reveal-up d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="facultySearch" class="form-control py-1 font-headings" placeholder="Search faculty name or designation..." style="width:280px; font-size:0.85rem;" />
    </div>

    <!-- Dual View Toggle Buttons -->
    <ul class="nav nav-pills gap-1 font-headings" id="facultyViewToggleTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="btn btn-sm btn-cyber-outline active px-3" id="f-cards-tab" data-bs-toggle="pill" data-bs-target="#facultyCardsView" type="button" role="tab">
                <i class="fa-solid fa-id-card me-1"></i> Grid Cards
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="btn btn-sm btn-cyber-outline px-3" id="f-table-tab" data-bs-toggle="pill" data-bs-target="#facultyTableView" type="button" role="tab">
                <i class="fa-solid fa-table-list me-1"></i> Data Table
            </button>
        </li>
    </ul>
</div>

<div class="tab-content" id="facultyViewsContent">
    
    <!-- Grid Cards View -->
    <div class="tab-pane fade show active" id="facultyCardsView" role="tabpanel">
        <div class="row g-4">
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="glass-card p-5 max-width-600 mx-auto text-muted">
                        <i class="fa-solid fa-users fa-3x mb-3 text-muted"></i>
                        <h4 class="text-light">No Faculty Members Found</h4>
                        <p>Click 'Add Faculty' above to create professor profiles.</p>
                    </div>
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="col-xl-4 col-md-6 faculty-card-item">
                        <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between" style="border-top: 3px solid var(--royal-blue);">
                            <div>
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="rounded-circle text-center d-flex align-items-center justify-content-center text-white font-headings" 
                                         style="width:55px; height:55px; background:linear-gradient(135deg, var(--cyan), var(--royal-blue)); font-size:1.2rem; font-weight:700;">
                                        @item.PhotoPath
                                    </div>
                                    <div>
                                        <h5 class="text-white font-headings fw-bold mb-1">@item.Name</h5>
                                        <small class="text-gradient-cyan font-headings font-monospace">@item.Designation</small>
                                    </div>
                                </div>
                                <p class="text-muted mb-3" style="font-size:0.88rem; line-height:1.5;">@item.Qualification</p>
                                
                                <div class="p-2 rounded mb-3" style="background:rgba(255,255,255,0.02); font-size:0.82rem;">
                                    <span class="text-muted d-block"><i class="fa-solid fa-building me-1 text-gradient-cyan"></i> Dept: @(item.Department?.Name ?? "General")</span>
                                    <span class="text-muted d-block text-truncate"><i class="fa-solid fa-envelope me-1 text-gradient-cyan"></i> @item.Email</span>
                                </div>
                            </div>

                            <div class="pt-3 border-top border-white border-opacity-10 d-flex justify-content-end gap-2">
                                <form asp-action="DeleteFaculty" method="post" onsubmit="return confirm('Move faculty profile to Recycle Bin?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger py-1 px-3" style="font-size:0.8rem;">
                                        <i class="fa-solid fa-trash-can me-1"></i> Trash
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Data Table View -->
    <div class="tab-pane fade" id="facultyTableView" role="tabpanel">
        <div class="glass-card p-4">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
                    <thead>
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                            <th>Initials</th>
                            <th>Name</th>
                            <th>Designation</th>
                            <th>Qualification</th>
                            <th>Department</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.95rem;">
                                <td>
                                    <div class="rounded-circle text-center d-flex align-items-center justify-content-center text-white font-headings" 
                                         style="width:40px; height:40px; background:linear-gradient(135deg, var(--cyan), var(--royal-blue)); font-size:0.95rem; font-weight:700;">
                                        @item.PhotoPath
                                    </div>
                                </td>
                                <td class="fw-semibold text-light">@item.Name</td>
                                <td class="text-muted">@item.Designation</td>
                                <td><span class="badge bg-secondary font-headings">@item.Qualification</span></td>
                                <td><span class="badge bg-primary px-2 py-1 font-headings">@(item.Department?.Code ?? "General")</span></td>
                                <td class="text-end">
                                    <form asp-action="DeleteFaculty" method="post" onsubmit="return confirm('Move faculty to Recycle Bin?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger py-1 px-3" style="font-size:0.8rem;">
                                            <i class="fa-solid fa-trash-can me-1"></i> Trash
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Add Faculty Member</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateFaculty" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Full Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="Prof. Dr. Hafiz Muhammad Saad" required />
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Designation</label>
                            <input type="text" name="Designation" class="form-control" placeholder="Dean / Chair Professor" required />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Qualification</label>
                            <input type="text" name="Qualification" class="form-control" placeholder="Ph.D. in Computer Science" required />
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Department</label>
                            <select name="DepartmentId" class="form-select" required>
                                @foreach (var d in depts)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Email Address</label>
                            <input type="email" name="Email" class="form-control" placeholder="saad@nedacademy.edu" required />
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Photo Initials (2-3 Chars)</label>
                            <input type="text" name="PhotoPath" class="form-control text-uppercase" placeholder="HS" maxlength="4" required />
                        </div>
                    </div>

                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Biography Summary</label>
                        <textarea name="Biography" rows="3" class="form-control" required></textarea>
                    </div>

                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Research Areas (CSV)</label>
                        <input type="text" name="ResearchAreas" class="form-control" placeholder="Distributed Systems, Quantum AI, Compilers" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Save Faculty Profile</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('facultySearch').addEventListener('input', (e) => {
            const val = e.target.value.toLowerCase();
            document.querySelectorAll('.faculty-card-item').forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(val) ? 'block' : 'none';
            });
        });
    </script>
}
