@model IEnumerable<NedAcademyWebsite.Models.AdmissionApplication>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admission Applications Queue";
    var currentStatus = ViewBag.CurrentStatus as string;
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0"><i class="fa-solid fa-id-card-clip text-cyan me-2"></i>Admission Applications Queue</h3>
        <p class="text-muted m-0 small">Review, audit, and process candidate online admission applications.</p>
    </div>
    <div>
        <span class="badge bg-primary px-3 py-2 fs-6">Total: @Model.Count() Applications</span>
    </div>
</div>

<!-- Filters & Search -->
<div class="card shadow-sm border-0 p-3 mb-4" style="background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(10px);">
    <form method="get" asp-action="Admissions" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="search" class="form-control bg-dark text-white border-secondary" placeholder="Search by App #, Candidate Name, or Email..." value="@search" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                <option value="">All Application Statuses</option>
                <option value="Submitted" selected="@(currentStatus == "Submitted")">Submitted (Pending Review)</option>
                <option value="UnderReview" selected="@(currentStatus == "UnderReview")">Under Review</option>
                <option value="Approved" selected="@(currentStatus == "Approved")">Approved (Portal Unlocked)</option>
                <option value="Rejected" selected="@(currentStatus == "Rejected")">Rejected</option>
                <option value="RequiresRevision" selected="@(currentStatus == "RequiresRevision")">Requires Revision</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-cyber w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            <a asp-action="Admissions" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate-left"></i></a>
        </div>
    </form>
</div>

<!-- Applications Table -->
<div class="card shadow-sm border-0 p-0 overflow-hidden" style="background: rgba(15, 23, 42, 0.4);">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle m-0">
            <thead class="table-dark text-uppercase small text-muted" style="border-bottom: 2px solid var(--glass-border);">
                <tr>
                    <th class="ps-4">App #</th>
                    <th>Applicant Details</th>
                    <th>Offered Program</th>
                    <th>Submission Date</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var statusBadge = item.CurrentStatus switch
                        {
                            NedAcademyWebsite.Models.ApplicationStatus.Submitted => "bg-primary",
                            NedAcademyWebsite.Models.ApplicationStatus.UnderReview => "bg-warning text-dark",
                            NedAcademyWebsite.Models.ApplicationStatus.Approved => "bg-success",
                            NedAcademyWebsite.Models.ApplicationStatus.Rejected => "bg-danger",
                            NedAcademyWebsite.Models.ApplicationStatus.RequiresRevision => "bg-info text-dark",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="ps-4 fw-bold text-cyan">@item.ApplicationNumber</td>
                            <td>
                                <div class="fw-bold">@(item.Applicant?.FullName ?? "Applicant #" + item.ApplicantId)</div>
                                <div class="small text-muted">@item.Applicant?.Email</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@(item.DegreeProgram?.Name ?? "Program #" + item.DegreeProgramId)</span>
                            </td>
                            <td>@item.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                <span class="badge @statusBadge">@item.CurrentStatus</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="ApplicantDetails" asp-route-id="@item.Id" class="btn btn-sm btn-cyber">
                                    <i class="fa-solid fa-folder-open me-1"></i> Digital Admission File
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-inbox fa-3x mb-3 d-block opacity-50"></i>
                            No admission applications found matching the selected criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
