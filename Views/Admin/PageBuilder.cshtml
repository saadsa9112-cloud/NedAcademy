@model IEnumerable<NedAcademyWebsite.Models.PageSection>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Universal Page Builder Engine";
    var pageKey = (string)ViewBag.PageKey;
    var pages = new[] { "Home", "About", "Admissions", "Programs", "Faculty", "Research", "Facilities", "Gallery", "News", "Contact" };
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Universal Page Builder</h1>
        <p class="text-muted m-0">Configure section order, visibility, background styling, and container layout across all 10 public pages.</p>
    </div>
</div>

<!-- Target Page Selector Bar -->
<div class="glass-card p-3 mb-4 reveal-up">
    <div class="d-flex align-items-center gap-2 flex-wrap font-headings" style="font-size:0.9rem;">
        <span class="text-muted fw-bold me-2"><i class="fa-solid fa-file-pen me-1 text-gradient-cyan"></i> Select Target Page:</span>
        @foreach (var p in pages)
        {
            <a asp-action="PageBuilder" asp-route-pageKey="@p" class="btn btn-sm @(pageKey == p ? "btn-cyber" : "btn-cyber-outline") px-3 py-1">
                @p
            </a>
        }
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-white font-headings fw-bold m-0"><i class="fa-solid fa-layer-group text-gradient-cyan me-2"></i> Section Layout Engine for [@pageKey]</h4>
        <small class="text-muted">Changes take effect immediately on public rendering</small>
    </div>

    <form asp-action="SavePageSections" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="pageKey" value="@pageKey" />

        <div class="d-flex flex-column gap-3">
            @for (int i = 0; i < Model.Count(); i++)
            {
                var sec = Model.ElementAt(i);
                <div class="glass-card p-3 d-flex align-items-center justify-content-between gap-3" style="background: rgba(255,255,255,0.02); border-left: 4px solid var(--cyan);">
                    <input type="hidden" name="sections[@i].Id" value="@sec.Id" />
                    <input type="hidden" name="sections[@i].PageKey" value="@sec.PageKey" />
                    <input type="hidden" name="sections[@i].SectionKey" value="@sec.SectionKey" />

                    <div class="d-flex align-items-center gap-3 flex-grow-1">
                        <div class="text-muted font-headings fw-bold" style="font-size:1.1rem; width:30px;">#@(i + 1)</div>
                        
                        <div class="flex-grow-1">
                            <label class="text-muted font-headings text-uppercase" style="font-size:0.7rem; font-weight:700;">Section Title</label>
                            <input type="text" name="sections[@i].SectionTitle" value="@sec.SectionTitle" class="form-control py-1 font-headings fw-bold" required />
                        </div>

                        <div style="width: 140px;">
                            <label class="text-muted font-headings text-uppercase" style="font-size:0.7rem; font-weight:700;">Background</label>
                            <select name="sections[@i].BackgroundStyle" class="form-select py-1">
                                <option value="Dark" selected="@(sec.BackgroundStyle == "Dark")">Dark Navy</option>
                                <option value="Glass" selected="@(sec.BackgroundStyle == "Glass")">Glassmorphic</option>
                                <option value="Light" selected="@(sec.BackgroundStyle == "Light")">Platinum Light</option>
                                <option value="Gradient" selected="@(sec.BackgroundStyle == "Gradient")">Cyber Gradient</option>
                            </select>
                        </div>

                        <div style="width: 130px;">
                            <label class="text-muted font-headings text-uppercase" style="font-size:0.7rem; font-weight:700;">Container</label>
                            <select name="sections[@i].ContainerWidth" class="form-select py-1">
                                <option value="Container" selected="@(sec.ContainerWidth == "Container")">Standard</option>
                                <option value="FullWidth" selected="@(sec.ContainerWidth == "FullWidth")">Full Width</option>
                            </select>
                        </div>

                        <div style="width: 90px;">
                            <label class="text-muted font-headings text-uppercase" style="font-size:0.7rem; font-weight:700;">Order</label>
                            <input type="number" name="sections[@i].SortOrder" value="@sec.SortOrder" class="form-control py-1" required />
                        </div>
                    </div>

                    <div class="form-check form-switch ms-3">
                        <input class="form-check-input" type="checkbox" name="sections[@i].IsVisible" value="true" @(sec.IsVisible ? "checked" : "") style="width: 45px; height: 22px;" />
                        <input type="hidden" name="sections[@i].IsVisible" value="false" />
                    </div>
                </div>
            }
        </div>

        <div class="mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
            <button type="submit" class="btn btn-cyber px-5 py-2 font-headings text-uppercase" style="font-size:0.85rem;">
                <i class="fa-solid fa-floppy-disk me-2"></i> Save [@pageKey] Page Layout
            </button>
        </div>
    </form>
</div>
