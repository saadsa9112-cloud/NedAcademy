@model IEnumerable<NedAcademyWebsite.Models.BackupRecord>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "System Backup & Restore Manager";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">System Backup & Snapshot Manager</h1>
        <p class="text-muted m-0">Generate database snapshots, archive media assets, or download emergency backup files.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="CreateBackup" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="type" value="Database" />
            <button type="submit" class="btn btn-cyber font-headings px-4 py-2">
                <i class="fa-solid fa-database me-1"></i> Snapshot Database
            </button>
        </form>
        <form asp-action="CreateBackup" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="type" value="MediaAssets" />
            <button type="submit" class="btn btn-cyber-outline font-headings px-4 py-2">
                <i class="fa-solid fa-file-zipper me-1"></i> Archive Media Zip
            </button>
        </form>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
            <thead>
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                    <th>Created Timestamp</th>
                    <th>Backup Type</th>
                    <th>File Archive Name</th>
                    <th>File Path</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No backup archives generated yet. Click 'Snapshot Database' above.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.95rem;">
                            <td class="text-muted font-monospace">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-primary px-2 py-1 font-headings">@item.BackupType</span></td>
                            <td class="fw-semibold text-light">@item.FileName</td>
                            <td class="text-muted font-monospace" style="font-size:0.85rem;">@item.FilePath</td>
                            <td class="text-end">
                                <a href="@item.FilePath" download class="btn btn-cyber-outline py-1 px-3" style="font-size:0.8rem;">
                                    <i class="fa-solid fa-download me-1"></i> Download
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
