@model IEnumerable<NedAcademyWebsite.Models.DownloadFile>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Downloadable Resources";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Manage Downloads</h1>
        <p class="text-muted m-0">Provide digital prospectus files, curriculum guidelines, calendars, and application forms.</p>
    </div>
    <div>
        <button class="btn btn-cyber font-headings px-4 py-2" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fa-solid fa-plus me-1"></i> Register File
        </button>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
            <thead>
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                    <th>Resource Title</th>
                    <th>Category</th>
                    <th>Size String</th>
                    <th>File Path/Reference</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No resource downloads registered yet.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.95rem;">
                            <td class="fw-semibold text-light">@item.Title</td>
                            <td>
                                @if (item.Category.ToLower() == "admissions")
                                {
                                    <span class="badge bg-primary px-2 py-1 font-headings">ADMISSIONS</span>
                                }
                                else if (item.Category.ToLower() == "academic")
                                {
                                    <span class="badge bg-success px-2 py-1 font-headings">ACADEMIC</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning px-2 py-1 font-headings text-dark">POLICIES</span>
                                }
                            </td>
                            <td class="text-muted">@item.SizeString</td>
                            <td class="text-muted font-monospace" style="font-size:0.85rem;">@item.FilePath</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-cyber-outline py-1 px-3" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editModal" 
                                            data-id="@item.Id" 
                                            data-title="@item.Title" 
                                            data-filepath="@item.FilePath" 
                                            data-sizestring="@item.SizeString" 
                                            data-category="@item.Category" 
                                            style="font-size:0.8rem;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                    </button>
                                    
                                    <form asp-action="DeleteDownload" method="post" onsubmit="return confirm('Confirm deletion of this downloadable resource?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger py-1 px-3" style="font-size:0.8rem;">
                                            <i class="fa-solid fa-trash-can me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Register Download File</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateDownload" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Resource Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="University Prospectus 2026" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Category</label>
                        <select name="Category" class="form-select" required>
                            <option value="admissions">Admissions</option>
                            <option value="academic">Academic</option>
                            <option value="policy">Policies</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">File Reference Path (e.g. /downloads/prospectus.pdf)</label>
                        <input type="text" name="FilePath" class="form-control" placeholder="/downloads/Prospectus_2026.pdf" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Size Label (e.g. PDF | 4.2 MB)</label>
                        <input type="text" name="SizeString" class="form-control" placeholder="PDF | 4.2 MB" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Register Resource</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Edit Download Registry</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditDownload" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Resource Title</label>
                        <input type="text" name="Title" id="editTitle" class="form-control" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Category</label>
                        <select name="Category" id="editCategory" class="form-select" required>
                            <option value="admissions">Admissions</option>
                            <option value="academic">Academic</option>
                            <option value="policy">Policies</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">File Reference Path</label>
                        <input type="text" name="FilePath" id="editFilePath" class="form-control" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Size Label</label>
                        <input type="text" name="SizeString" id="editSizeString" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = document.getElementById('editModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', (e) => {
                const trigger = e.relatedTarget;
                
                document.getElementById('editId').value = trigger.getAttribute('data-id');
                document.getElementById('editTitle').value = trigger.getAttribute('data-title');
                document.getElementById('editFilePath').value = trigger.getAttribute('data-filepath');
                document.getElementById('editSizeString').value = trigger.getAttribute('data-sizestring');
                document.getElementById('editCategory').value = trigger.getAttribute('data-category');
            });
        }
    </script>
}
