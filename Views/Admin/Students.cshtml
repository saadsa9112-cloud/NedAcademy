@model IEnumerable<NedAcademyWebsite.Models.EnrollmentRecord>
@using NedAcademyWebsite.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Academic Registry — Enrolled Students Directory";
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var batches = ViewBag.Batches as List<string> ?? new List<string>();
    string currentDept = ViewBag.CurrentDept as string ?? "";
    string currentBatch = ViewBag.CurrentBatch as string ?? "";
    string search = ViewBag.Search as string ?? "";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success bg-opacity-10 text-success font-headings px-2 py-1">
                    <i class="fa-solid fa-graduation-cap me-1"></i> ACADEMIC REGISTRY (UMS)
                </span>
                <span class="badge bg-secondary bg-opacity-10 text-muted font-headings px-2 py-1">
                    <i class="fa-solid fa-users me-1"></i> @Model.Count() Active Students
                </span>
            </div>
            <h2 class="font-headings fw-bold mb-1">Enrolled Students Academic Directory</h2>
            <p class="text-muted mb-0 small">Official student registry synchronized from Admission Committee approvals and fee verifications.</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-modern-outline btn-sm font-headings" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print Roster
            </button>
            <a href="/Admissions" class="btn btn-modern-primary btn-sm font-headings">
                <i class="fa-solid fa-id-card-clip me-1"></i> Admissions Queue
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="app-card p-3" style="border-left: 4px solid var(--app-primary);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase font-headings fw-bold">Total Enrolled</span>
                        <h3 class="font-headings fw-bold mt-1 mb-0">@Model.Count()</h3>
                    </div>
                    <div class="rounded-3 p-2 bg-primary bg-opacity-10 text-primary fs-4">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="app-card p-3" style="border-left: 4px solid var(--app-emerald);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase font-headings fw-bold">Active Status</span>
                        <h3 class="text-success font-headings fw-bold mt-1 mb-0">@Model.Count(e => e.EnrollmentStatus == "Active")</h3>
                    </div>
                    <div class="rounded-3 p-2 bg-success bg-opacity-10 text-success fs-4">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="app-card p-3" style="border-left: 4px solid var(--app-amber);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase font-headings fw-bold">Departments</span>
                        <h3 class="text-warning font-headings fw-bold mt-1 mb-0">@departments.Count</h3>
                    </div>
                    <div class="rounded-3 p-2 bg-warning bg-opacity-10 text-warning fs-4">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="app-card p-3" style="border-left: 4px solid var(--app-purple);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase font-headings fw-bold">Academic Batches</span>
                        <h3 class="font-headings fw-bold mt-1 mb-0">@(batches.Count > 0 ? batches.Count : 1)</h3>
                    </div>
                    <div class="rounded-3 p-2 bg-purple bg-opacity-10 font-headings fs-4" style="color: var(--app-purple);">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="app-card p-3 mb-4">
        <form method="get" asp-action="Students" class="row g-2 align-items-center">
            <input type="hidden" name="workspace" value="academic" />
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="fa-solid fa-search"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by Student ID, Roll No, Name, Program..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="department" class="form-select" onchange="this.form.submit()">
                    <option value="">All Academic Departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Code" selected="@(currentDept == d.Code)">@d.Name (@d.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="batch" class="form-select" onchange="this.form.submit()">
                    <option value="">All Batches</option>
                    @foreach (var b in batches)
                    {
                        <option value="@b" selected="@(currentBatch == b)">@b</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-modern-primary w-100 font-headings">Filter</button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(currentDept) || !string.IsNullOrEmpty(currentBatch))
                {
                    <a asp-action="Students" asp-route-workspace="academic" class="btn btn-modern-outline font-headings" title="Clear Filters"><i class="fa-solid fa-xmark"></i></a>
                }
            </div>
        </form>
    </div>

    <!-- Enrolled Students Table -->
    <div class="app-card p-0 overflow-hidden">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Student Details</th>
                            <th>Student ID</th>
                            <th>Roll Number</th>
                            <th>Program &amp; Department</th>
                            <th>Batch &amp; Semester</th>
                            <th>Activation Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 1; }
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="text-muted font-monospace">@(idx++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white font-headings fw-bold shadow-sm" 
                                             style="width: 40px; height: 40px; background: linear-gradient(135deg, #2563eb, #1d4ed8); font-size:0.85rem;">
                                            @((student.Applicant?.FullName ?? "S")[0])
                                        </div>
                                        <div>
                                            <div class="fw-bold">@(student.Applicant?.FullName ?? "Student Name")</div>
                                            <div class="text-muted small">@(student.Applicant?.Email ?? "N/A")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary font-monospace px-2 py-1">@student.GeneratedStudentId</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-dark font-monospace px-2 py-1">@student.GeneratedRollNumber</span>
                                </td>
                                <td>
                                    <div class="fw-bold small text-truncate" style="max-width: 220px;" title="@student.DegreeProgram?.Name">
                                        @(student.DegreeProgram?.Name ?? "General Degree Program")
                                    </div>
                                    <div class="text-muted small">@(student.Department?.Name ?? "Computer Science Dept")</div>
                                </td>
                                <td>
                                    <div class="small fw-bold">@student.Batch</div>
                                    <div class="text-muted small">@student.Semester</div>
                                </td>
                                <td class="text-muted small">
                                    @student.ActivationDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="badge @(student.EnrollmentStatus == "Active" ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning")">
                                        <i class="fa-solid @(student.EnrollmentStatus == "Active" ? "fa-circle-check" : "fa-clock") me-1"></i> @student.EnrollmentStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="ApplicantDetails" asp-route-id="@student.AdmissionApplicationId" class="btn btn-sm btn-modern-outline font-headings px-3" title="Open Complete Admission Dossier">
                                        <i class="fa-solid fa-folder-open me-1"></i> Dossier
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center">
                <div class="rounded-circle d-inline-flex p-3 bg-secondary bg-opacity-10 text-muted mb-3" style="font-size: 2.5rem;">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>
                <h5 class="font-headings fw-bold">No Enrolled Students Found</h5>
                <p class="text-muted small mb-3">No students match your filter criteria or admission decisions have not yet been approved.</p>
                <a href="/Admissions" class="btn btn-sm btn-modern-primary font-headings px-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> Go to Applications Queue
                </a>
            </div>
        }
    </div>
</div>