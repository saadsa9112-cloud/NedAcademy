@model IEnumerable<NedAcademyWebsite.Models.SectionSetting>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Homepage Layout Manager";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Homepage Layout Manager</h1>
        <p class="text-muted m-0">Reorder, show/hide, or adjust background styling for all homepage sections.</p>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <form asp-action="SaveStructure" method="post">
        @Html.AntiForgeryToken()
        
        <div class="d-flex flex-column gap-3 mb-4">
            @for (int i = 0; i < Model.Count(); i++)
            {
                var item = Model.ElementAt(i);
                <div class="glass-card p-3 d-flex align-items-center justify-content-between gap-3" style="background: rgba(255,255,255,0.02); border-left: 4px solid var(--royal-blue);">
                    <input type="hidden" name="sections[@i].Id" value="@item.Id" />
                    <input type="hidden" name="sections[@i].SectionKey" value="@item.SectionKey" />
                    <input type="hidden" name="sections[@i].DisplayName" value="@item.DisplayName" />

                    <div class="d-flex align-items-center gap-3 flex-grow-1">
                        <i class="fa-solid fa-grip-vertical text-muted"></i>
                        <div class="fw-bold text-light font-headings" style="min-width: 200px;">@item.DisplayName</div>

                        <div style="width: 150px;">
                            <label class="text-muted font-headings text-uppercase" style="font-size:0.7rem; font-weight:700;">Background</label>
                            <select name="sections[@i].BackgroundStyle" class="form-select py-1">
                                <option value="Dark" selected="@(item.BackgroundStyle == "Dark")">Dark Navy</option>
                                <option value="Glass" selected="@(item.BackgroundStyle == "Glass")">Glassmorphic</option>
                                <option value="Light" selected="@(item.BackgroundStyle == "Light")">Platinum Light</option>
                                <option value="Gradient" selected="@(item.BackgroundStyle == "Gradient")">Cyber Gradient</option>
                            </select>
                        </div>

                        <div style="width: 90px;">
                            <label class="text-muted font-headings text-uppercase" style="font-size:0.7rem; font-weight:700;">Sort Rank</label>
                            <input type="number" name="sections[@i].SortOrder" value="@item.SortOrder" class="form-control py-1" required />
                        </div>
                    </div>

                    <div class="form-check form-switch ms-3">
                        <input class="form-check-input" type="checkbox" name="sections[@i].IsVisible" value="true" @(item.IsVisible ? "checked" : "") style="width: 45px; height: 22px;" />
                        <input type="hidden" name="sections[@i].IsVisible" value="false" />
                    </div>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-cyber px-5 py-2 font-headings text-uppercase" style="font-size:0.85rem;">
            <i class="fa-solid fa-floppy-disk me-2"></i> Save Homepage Section Rules
        </button>
    </form>
</div>
