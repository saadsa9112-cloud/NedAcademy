@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CMS Administrative Portal - Ned Academy</title>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <!-- Custom site theme colors -->
    <style>
        :root {
            --bg-color: #030712;
            --card-bg: rgba(15, 23, 42, 0.45);
            --glass-border: rgba(255, 255, 255, 0.08);
            --cyan: #00f2fe;
            --royal-blue: #0077ff;
            --text-muted: #94a3b8;
            --text-light: #f8fafc;
        }

        body {
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(0, 119, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 90% 80%, rgba(0, 242, 254, 0.08) 0%, transparent 50%);
            color: var(--text-light);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
        }

        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            width: 100%;
            max-width: 450px;
            padding: 40px;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .font-headings {
            font-family: 'Outfit', sans-serif;
        }

        .text-gradient-cyan {
            background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-cyber {
            background: linear-gradient(135deg, var(--cyan) 0%, var(--royal-blue) 100%);
            border: none;
            color: #000;
            font-weight: 700;
            border-radius: 8px;
            padding: 12px;
            transition: all 0.3s ease;
        }

        .btn-cyber:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
            color: #000;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--glass-border);
            color: #fff !important;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 0.95rem;
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--cyan);
            box-shadow: 0 0 10px rgba(0, 242, 254, 0.15);
        }

        .text-danger {
            color: #ff3b30 !important;
            font-size: 0.85rem;
        }

        /* Force light text globally in the Admin Login page */
        body, p, span, h1, h2, h3, h4, h5, h6, li, label, .form-label {
            color: var(--text-light);
        }
        p, .text-muted {
            color: var(--text-muted) !important;
        }
    </style>
</head>
<body>
    <div class="glass-card text-center" style="border-top: 4px solid var(--cyan);">
        <div class="mb-4">
            <h2 class="font-headings fw-bold mb-1"><span class="text-gradient-cyan">NED ACADEMY</span></h2>
            <p class="text-uppercase font-headings text-muted fw-bold" style="font-size:0.75rem; letter-spacing:0.15em;">Administrative Portal</p>
        </div>
        
        <form asp-action="Login" asp-controller="Admin" method="post" class="text-start d-flex flex-column gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            
            <div>
                <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Username</label>
                <div class="position-relative">
                    <input type="text" name="username" class="form-control" placeholder="Admin Username" required />
                </div>
            </div>
            
            <div>
                <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Password</label>
                <div class="position-relative">
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                </div>
            </div>
            
            <div class="mt-3">
                <button type="submit" class="btn btn-cyber w-100 py-3 font-headings text-uppercase" style="font-size:0.85rem; letter-spacing:0.05em;">Access CMS System</button>
            </div>
        </form>
        
        <div class="mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.05);">
            <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none" style="font-size:0.85rem;"><i class="fa-solid fa-arrow-left me-1"></i> Return to Main Website</a>
        </div>
    </div>
</body>
</html>
