@model IEnumerable<NedAcademyWebsite.Models.ResearchItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Research & Innovation";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Manage Research</h1>
        <p class="text-muted m-0">Configure dynamic computational laboratories and active academic research projects.</p>
    </div>
    <div>
        <button class="btn btn-cyber font-headings px-4 py-2" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fa-solid fa-plus me-1"></i> Add Research Item
        </button>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
            <thead>
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                    <th>ID</th>
                    <th>Category</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No research items registered.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.95rem;">
                            <td class="text-muted">@item.Id</td>
                            <td>
                                @if (item.Category.ToLower() == "lab")
                                {
                                    <span class="badge bg-info px-2 py-1 font-headings">LABORATORY</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-2 py-1 font-headings">ACTIVE PROJECT</span>
                                }
                            </td>
                            <td class="fw-semibold text-light">@item.Title</td>
                            <td class="text-muted text-truncate" style="max-width:350px;">@item.Description</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-cyber-outline py-1 px-3" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editModal" 
                                            data-id="@item.Id" 
                                            data-category="@item.Category" 
                                            data-title="@item.Title" 
                                            data-description="@item.Description" 
                                            style="font-size:0.8rem;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                    </button>
                                    
                                    <form asp-action="DeleteResearch" method="post" onsubmit="return confirm('Confirm deletion of this research item?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger py-1 px-3" style="font-size:0.8rem;">
                                            <i class="fa-solid fa-trash-can me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Register Research Item</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateResearch" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Category Type</label>
                        <select name="Category" class="form-select" required>
                            <option value="Lab">Research Facility / Laboratory</option>
                            <option value="Project">Active Academic Project</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. HPC & GPU Compute Cluster" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Description</label>
                        <textarea name="Description" rows="4" class="form-control" placeholder="Description of capabilities, outcomes, hardware..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Save Registry</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Edit Research Item</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditResearch" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Category Type</label>
                        <select name="Category" id="editCategory" class="form-select" required>
                            <option value="Lab">Research Facility / Laboratory</option>
                            <option value="Project">Active Academic Project</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Title</label>
                        <input type="text" name="Title" id="editTitle" class="form-control" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Description</label>
                        <textarea name="Description" id="editDescription" rows="4" class="form-control" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = document.getElementById('editModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', (e) => {
                const trigger = e.relatedTarget;
                
                document.getElementById('editId').value = trigger.getAttribute('data-id');
                document.getElementById('editCategory').value = trigger.getAttribute('data-category');
                document.getElementById('editTitle').value = trigger.getAttribute('data-title');
                document.getElementById('editDescription').value = trigger.getAttribute('data-description');
            });
        }
    </script>
}
