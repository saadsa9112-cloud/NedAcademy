@model IEnumerable<NedAcademyWebsite.Models.Department>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Departments";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Manage Departments</h1>
        <p class="text-muted m-0">Create, update, or remove academic department metadata registries.</p>
    </div>
    <div>
        <button class="btn btn-cyber font-headings px-4 py-2" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fa-solid fa-plus me-1"></i> Add Department
        </button>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
            <thead>
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                    <th>ID</th>
                    <th>Code</th>
                    <th>Department Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No departments registered. Add one using the button above.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.95rem;">
                            <td class="text-muted">@item.Id</td>
                            <td><span class="badge bg-primary text-uppercase font-headings">@item.Code</span></td>
                            <td class="fw-semibold text-light">@item.Name</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-cyber-outline py-1 px-3" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editModal" 
                                            data-id="@item.Id" 
                                            data-code="@item.Code" 
                                            data-name="@item.Name" 
                                            style="font-size:0.8rem;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                    </button>
                                    
                                    <form asp-action="DeleteDepartment" method="post" onsubmit="return confirm('Warning: Deleting a department will delete all programs and faculty linked to it. Proceed?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger py-1 px-3" style="font-size:0.8rem;">
                                            <i class="fa-solid fa-trash-can me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Register Department</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateDepartment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Code Key (e.g. CS-AI)</label>
                        <input type="text" name="Code" class="form-control text-uppercase" placeholder="CS-AI" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Department Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="Computer Science & Artificial Intelligence" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Create Registry</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Edit Department</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditDepartment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Code Key</label>
                        <input type="text" name="Code" id="editCode" class="form-control text-uppercase" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Department Name</label>
                        <input type="text" name="Name" id="editName" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = document.getElementById('editModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', (e) => {
                const trigger = e.relatedTarget;
                const id = trigger.getAttribute('data-id');
                const code = trigger.getAttribute('data-code');
                const name = trigger.getAttribute('data-name');
                
                document.getElementById('editId').value = id;
                document.getElementById('editCode').value = code;
                document.getElementById('editName').value = name;
            });
        }
    </script>
}
