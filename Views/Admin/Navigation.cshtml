@model IEnumerable<NedAcademyWebsite.Models.NavMenuItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Header Navigation Manager";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Header Navigation Manager</h1>
        <p class="text-muted m-0">Create, edit, or remove navbar menus, dropdown submenus, external links, and sort positions.</p>
    </div>
    <div>
        <button class="btn btn-cyber font-headings px-4 py-2" data-bs-toggle="modal" data-bs-target="#createNavModal">
            <i class="fa-solid fa-plus me-1"></i> Add Nav Link
        </button>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
            <thead>
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                    <th>Sort</th>
                    <th>Icon</th>
                    <th>Menu Title</th>
                    <th>URL Target Path</th>
                    <th>Visibility</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No dynamic navigation menu items registered yet. Click button above.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.95rem;">
                            <td class="text-muted font-monospace">#@item.SortOrder</td>
                            <td><i class="fa-solid @item.Icon text-gradient-cyan"></i></td>
                            <td class="fw-semibold text-light">@item.MenuName</td>
                            <td class="text-muted font-monospace" style="font-size:0.85rem;">@item.Url</td>
                            <td>
                                @if (item.IsVisible)
                                {
                                    <span class="badge bg-success bg-opacity-20 text-success px-2 py-1">Visible</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-20 text-muted px-2 py-1">Hidden</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteNavMenu" method="post" onsubmit="return confirm('Remove navigation item?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger py-1 px-3" style="font-size:0.8rem;">
                                        <i class="fa-solid fa-trash-can me-1"></i> Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createNavModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Add Navigation Link</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateNavMenu" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Menu Title</label>
                        <input type="text" name="MenuName" class="form-control" placeholder="e.g. Research Hub" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">URL Target Path (e.g. /Home/Research)</label>
                        <input type="text" name="Url" class="form-control" placeholder="/Home/Research" required />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">FontAwesome Icon</label>
                            <input type="text" name="Icon" class="form-control" value="fa-link" required />
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Sort Order</label>
                            <input type="number" name="SortOrder" class="form-control" value="10" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Create Nav Link</button>
                </div>
            </form>
        </div>
    </div>
</div>
