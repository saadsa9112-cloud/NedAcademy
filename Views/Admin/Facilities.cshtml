@model IEnumerable<NedAcademyWebsite.Models.CampusFacility>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Campus Facilities";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">Manage Facilities</h1>
        <p class="text-muted m-0">Create, edit, or remove campus structures and student welfare infrastructure.</p>
    </div>
    <div>
        <button class="btn btn-cyber font-headings px-4 py-2" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fa-solid fa-plus me-1"></i> Add Facility
        </button>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
            <thead>
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                    <th>Icon</th>
                    <th>Facility Title</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No campus facilities registered.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.95rem;">
                            <td>
                                <div class="rounded-3 text-center d-flex align-items-center justify-content-center text-gradient-cyan" 
                                     style="width:40px; height:40px; background:rgba(255,255,255,0.02); border:1px solid var(--glass-border); font-size:1.1rem;">
                                    <i class="fa-solid @item.IconClass"></i>
                                </div>
                            </td>
                            <td class="fw-semibold text-light">@item.Title</td>
                            <td class="text-muted" style="max-width:350px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@item.Description</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-cyber-outline py-1 px-3" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editModal" 
                                            data-id="@item.Id" 
                                            data-title="@item.Title" 
                                            data-description="@item.Description" 
                                            data-iconclass="@item.IconClass" 
                                            style="font-size:0.8rem;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                    </button>
                                    
                                    <form asp-action="DeleteFacility" method="post" onsubmit="return confirm('Confirm deletion of this campus facility?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger py-1 px-3" style="font-size:0.8rem;">
                                            <i class="fa-solid fa-trash-can me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Add Campus Facility</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateFacility" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Facility Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. HPC Computer Labs" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">FontAwesome Icon Class (e.g. fa-server)</label>
                        <input type="text" name="IconClass" class="form-control" placeholder="fa-server" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Description</label>
                        <textarea name="Description" rows="3" class="form-control" placeholder="Brief outline..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Create Registry</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 p-4" style="background:#090f20; color:#fff;">
            <div class="modal-header border-0 p-0 mb-4 justify-content-between">
                <h4 class="modal-title font-headings fw-bold">Edit Campus Facility</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditFacility" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-body p-0 d-flex flex-column gap-3">
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Facility Title</label>
                        <input type="text" name="Title" id="editTitle" class="form-control" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">FontAwesome Icon Class</label>
                        <input type="text" name="IconClass" id="editIconClass" class="form-control" required />
                    </div>
                    <div>
                        <label class="text-muted font-headings mb-1" style="font-size:0.8rem; font-weight:600; text-transform:uppercase;">Description</label>
                        <textarea name="Description" id="editDescription" rows="3" class="form-control" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-0 mt-4">
                    <button type="button" class="btn btn-cyber-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-cyber">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = document.getElementById('editModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', (e) => {
                const trigger = e.relatedTarget;
                
                document.getElementById('editId').value = trigger.getAttribute('data-id');
                document.getElementById('editTitle').value = trigger.getAttribute('data-title');
                document.getElementById('editDescription').value = trigger.getAttribute('data-description');
                document.getElementById('editIconClass').value = trigger.getAttribute('data-iconclass');
            });
        }
    </script>
}
