@model IEnumerable<NedAcademyWebsite.Models.ScholarshipRule>
@{
    ViewData["Title"] = "Scholarship Rules Engine";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="font-headings text-white fw-bold m-0"><i class="fa-solid fa-graduation-cap text-cyan me-2"></i>Dynamic Scholarship Rules Engine</h3>
            <p class="text-muted small m-0">Configure university merit scholarships, waiver percentages, and eligibility criteria</p>
        </div>
        <button type="button" class="btn btn-cyber btn-sm" data-bs-toggle="modal" data-bs-target="#addScholarshipModal">
            <i class="fa-solid fa-plus me-1"></i> Add New Scholarship Rule
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-dark-success text-white border-success mb-4">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle border-secondary m-0">
                <thead>
                    <tr class="text-cyan border-secondary" style="background: rgba(15,23,42,0.8);">
                        <th>Rule ID</th>
                        <th>Scholarship Name</th>
                        <th>Description</th>
                        <th>Min Test Score %</th>
                        <th>Waiver Discount %</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var rule in Model)
                        {
                            <tr>
                                <td class="fw-bold">#SCH-@rule.Id</td>
                                <td class="fw-bold text-white">@rule.ScholarshipName</td>
                                <td class="text-muted small">@rule.Description</td>
                                <td><span class="badge bg-info text-dark">≥ @rule.MinimumPercentage%</span></td>
                                <td><span class="badge bg-success">@rule.ScholarshipPercentage% Fee Waiver</span></td>
                                <td>
                                    @if (rule.IsEnabled)
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="DeleteScholarshipRule" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this scholarship rule?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rule.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2"><i class="fa-solid fa-trash-can"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No scholarship rules configured. Click above to add a rule.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add Scholarship Rule -->
<div class="modal fade" id="addScholarshipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title font-headings text-white"><i class="fa-solid fa-plus-circle text-cyan me-2"></i>Configure Scholarship Rule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveScholarshipRule" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body d-flex flex-column gap-3">
                    <div>
                        <label class="form-label text-cyan small fw-bold">Scholarship Name</label>
                        <input type="text" name="ScholarshipName" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Merit Scholarship" required />
                    </div>
                    <div>
                        <label class="form-label text-cyan small fw-bold">Description</label>
                        <textarea name="Description" class="form-control bg-dark text-white border-secondary" rows="2" placeholder="Scholarship details and eligibility description"></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label text-cyan small fw-bold">Min Score Percentage (%)</label>
                            <input type="number" step="0.1" name="MinimumPercentage" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 75" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-cyan small fw-bold">Fee Waiver Percentage (%)</label>
                            <input type="number" step="0.1" name="ScholarshipPercentage" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 40" required />
                        </div>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="IsEnabled" value="true" checked id="switchEnable" />
                        <label class="form-check-label text-white small" for="switchEnable">Enable Rule Immediately</label>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-cyber btn-sm"><i class="fa-solid fa-save me-1"></i> Save Scholarship Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>
