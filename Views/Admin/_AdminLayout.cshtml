<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise CMS Portal</title>
    
    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- CKEditor 5 -->
    <script src="https://cdn.ckeditor.com/ckeditor5/38.1.0/classic/ckeditor.js"></script>
    <style>
        :root {
            --bg-color: #030712;
            --card-bg: rgba(15, 23, 42, 0.45);
            --glass-border: rgba(255, 255, 255, 0.08);
            --cyan: #00f2fe;
            --royal-blue: #0077ff;
            --text-muted: #cbd5e1;
            --text-light: #f8fafc;
            --font-headings: 'Outfit', 'Space Grotesk', system-ui, sans-serif;
            --font-body: 'Inter', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(0, 119, 255, 0.06) 0%, transparent 65%),
                radial-gradient(circle at 90% 80%, rgba(0, 242, 254, 0.06) 0%, transparent 65%);
            color: var(--text-light);
            font-family: var(--font-body);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
            min-height: 100vh;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6, .font-headings { font-family: var(--font-headings); letter-spacing: -0.02em; }

        .text-gradient-cyan {
            background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }

        .sidebar {
            width: 270px;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-right: 1px solid var(--glass-border);
            position: fixed;
            top: 0; bottom: 0; left: 0;
            z-index: 100;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-y: auto;
        }

        .topbar {
            margin-left: 270px;
            height: 70px;
            background: rgba(15, 23, 42, 0.4);
            border-bottom: 1px solid var(--glass-border);
            backdrop-filter: blur(15px);
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .main-content {
            margin-left: 270px;
            padding: 40px;
            min-height: calc(100vh - 70px);
        }

        .nav-link-custom {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.2s ease;
            font-size: 0.92rem;
        }

        .nav-link-custom:hover, .nav-link-custom.active {
            color: #fff;
            background: rgba(0, 242, 254, 0.08);
            box-shadow: inset 0 0 10px rgba(0, 242, 254, 0.1);
        }

        .nav-link-custom.active i { color: var(--cyan); }

        .nav-section-header {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: rgba(255,255,255,0.4);
            margin: 16px 0 6px 10px;
            font-weight: 700;
        }

        .btn-cyber {
            background: linear-gradient(135deg, var(--cyan) 0%, var(--royal-blue) 100%);
            border: none;
            color: #000;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-cyber:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.35);
            color: #000;
        }

        .btn-cyber-outline {
            background: transparent;
            border: 1px solid var(--cyan);
            color: var(--cyan);
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .btn-cyber-outline:hover {
            background: rgba(0, 242, 254, 0.08);
            color: #fff;
        }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--glass-border);
            color: #fff !important;
            border-radius: 8px;
            padding: 10px 14px;
            font-family: var(--font-body);
        }
        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--cyan);
            box-shadow: 0 0 10px rgba(0, 242, 254, 0.15);
        }
        .form-select option { background: #0b1329; color: #fff; }

        body, p, span, h1, h2, h3, h4, h5, h6, li, label, .form-label, th, td, a { color: var(--text-light); }
        p, .text-muted { color: var(--text-muted) !important; }
        .table { color: var(--text-light) !important; }
        .table th, .table td { color: var(--text-light) !important; }
        .modal-content { color: var(--text-light) !important; }

        .ck-editor__editable {
            background-color: #0b1329 !important;
            color: #ffffff !important;
            min-height: 180px;
        }
    </style>
</head>
<body>

    <!-- Sidebar Navigation -->
    <div class="sidebar d-flex flex-column justify-content-between">
        <div>
            <div class="mb-3 text-center">
                <h4 class="font-headings fw-bold m-0"><span class="text-gradient-cyan">NED CMS</span></h4>
                <small class="text-muted text-uppercase font-headings" style="font-size:0.65rem; letter-spacing:0.1em;">Enterprise Architecture</small>
            </div>
            
            <nav class="d-flex flex-column">
                <div class="nav-section-header">Core Dashboard</div>
                <a asp-action="Index" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fa-solid fa-gauge"></i> Executive Console
                </a>
                <a asp-action="Settings" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="fa-solid fa-sliders"></i> Site Settings (10 Tabs)
                </a>

                <div class="nav-section-header">Page & Layout Engine</div>
                <a asp-action="PageBuilder" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "PageBuilder" ? "active" : "")">
                    <i class="fa-solid fa-cubes"></i> Universal Page Builder
                </a>
                <a asp-action="Structure" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Structure" ? "active" : "")">
                    <i class="fa-solid fa-layer-group"></i> Homepage Layout
                </a>
                <a asp-action="Navigation" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Navigation" ? "active" : "")">
                    <i class="fa-solid fa-bars"></i> Navigation Manager
                </a>
                <a asp-action="FormBuilder" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "FormBuilder" ? "active" : "")">
                    <i class="fa-solid fa-rectangle-list"></i> Dynamic Form Builder
                </a>

                <div class="nav-section-header">Admission ERP System</div>
                <a asp-action="Admissions" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Admissions" || ViewContext.RouteData.Values["action"]?.ToString() == "ApplicantDetails" ? "active" : "")">
                    <i class="fa-solid fa-id-card-clip"></i> Applications Queue
                </a>
                <a asp-action="Scholarships" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Scholarships" ? "active" : "")">
                    <i class="fa-solid fa-award"></i> Scholarships Engine
                </a>
                <a asp-action="FeeConfig" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "FeeConfig" ? "active" : "")">
                    <i class="fa-solid fa-calculator"></i> Fee Structure Config
                </a>

                <div class="nav-section-header">Content Modules</div>
                <a asp-action="Programs" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Programs" ? "active" : "")">
                    <i class="fa-solid fa-graduation-cap"></i> Degree Programs
                </a>
                <a asp-action="Faculty" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Faculty" ? "active" : "")">
                    <i class="fa-solid fa-users-line"></i> Faculty Directory
                </a>
                <a asp-action="News" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "News" ? "active" : "")">
                    <i class="fa-solid fa-newspaper"></i> News & Events
                </a>
                <a asp-action="Research" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Research" ? "active" : "")">
                    <i class="fa-solid fa-microchip"></i> Research Labs
                </a>
                <a asp-action="Facilities" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Facilities" ? "active" : "")">
                    <i class="fa-solid fa-school"></i> Campus Facilities
                </a>
                <a asp-action="Media" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Media" ? "active" : "")">
                    <i class="fa-solid fa-photo-film"></i> Media Assets
                </a>
                <a asp-action="Messages" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Messages" ? "active" : "")">
                    <i class="fa-solid fa-envelope"></i> Inquiries Inbox
                </a>

                <div class="nav-section-header">System Utilities</div>
                <a asp-action="AuditLogs" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")">
                    <i class="fa-solid fa-clock-rotate-left"></i> Audit Logs
                </a>
                <a asp-action="RecycleBin" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "RecycleBin" ? "active" : "")">
                    <i class="fa-solid fa-trash-arrow-up"></i> Recycle Bin
                </a>
                <a asp-action="Backups" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Backups" ? "active" : "")">
                    <i class="fa-solid fa-database"></i> Backup Manager
                </a>
            </nav>
        </div>

        <div class="pt-3">
            <hr style="border-color: rgba(255,255,255,0.08); margin: 10px 0;" />
            <a asp-controller="Home" asp-action="Index" class="nav-link-custom mb-1" target="_blank">
                <i class="fa-solid fa-globe text-gradient-cyan"></i> Live Public Site
            </a>
            <a asp-action="Logout" class="nav-link-custom text-danger">
                <i class="fa-solid fa-right-from-bracket"></i> Logout Console
            </a>
        </div>
    </div>

    <!-- Topbar Area -->
    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <div class="position-relative" style="width: 320px;">
                <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="globalSearchInput" class="form-control ps-5 py-2 font-headings" style="font-size:0.85rem;" placeholder="Global Search (Ctrl+K)..." />
                <div id="searchResultsDropdown" class="position-absolute top-100 start-0 w-100 glass-card mt-2 p-2 d-none" style="z-index: 200; background:#0b1329;"></div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <button class="btn btn-cyber-outline py-1 px-3 dropdown-toggle" data-bs-toggle="dropdown" style="font-size:0.85rem;">
                    <i class="fa-solid fa-plus me-1"></i> Quick Action
                </button>
                <ul class="dropdown-menu dropdown-menu-dark" style="background:#0b1329;">
                    <li><a class="dropdown-item" asp-action="Programs"><i class="fa-solid fa-graduation-cap me-2"></i> Add Program</a></li>
                    <li><a class="dropdown-item" asp-action="Faculty"><i class="fa-solid fa-users-line me-2"></i> Add Faculty</a></li>
                    <li><a class="dropdown-item" asp-action="News"><i class="fa-solid fa-newspaper me-2"></i> Publish News</a></li>
                    <li><a class="dropdown-item" asp-action="Media"><i class="fa-solid fa-cloud-arrow-up me-2"></i> Upload File</a></li>
                </ul>
            </div>

            <div class="rounded-circle text-center d-flex align-items-center justify-content-center text-white font-headings fw-bold"
                 style="width:38px; height:38px; background:linear-gradient(135deg, var(--cyan), var(--royal-blue));">
                AD
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

    <!-- Global Search Script (Ctrl+K) -->
    <script>
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                document.getElementById('globalSearchInput').focus();
            }
        });

        const searchInput = document.getElementById('globalSearchInput');
        const resultsDropdown = document.getElementById('searchResultsDropdown');

        searchInput.addEventListener('input', () => {
            const val = searchInput.value.trim();
            if (val.length < 2) {
                resultsDropdown.classList.add('d-none');
                return;
            }

            fetch(`/Admin/GlobalSearch?q=${encodeURIComponent(val)}`)
                .then(res => res.json())
                .then(data => {
                    if (data.length === 0) {
                        resultsDropdown.innerHTML = `<div class="p-2 text-muted text-center" style="font-size:0.85rem;">No results found.</div>`;
                    } else {
                        resultsDropdown.innerHTML = data.map(item => `
                            <a href="${item.url}" class="d-flex align-items-center gap-2 p-2 text-decoration-none text-light rounded hover-bg-dark" style="font-size:0.88rem;">
                                <i class="fa-solid ${item.icon} text-gradient-cyan"></i>
                                <div>
                                    <div class="fw-semibold">${item.title}</div>
                                    <small class="text-muted" style="font-size:0.75rem;">${item.category}</small>
                                </div>
                            </a>
                        `).join('');
                    }
                    resultsDropdown.classList.remove('d-none');
                });
        });

        document.addEventListener('click', (e) => {
            if (!searchInput.contains(e.target) && !resultsDropdown.contains(e.target)) {
                resultsDropdown.classList.add('d-none');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Alert Notifications -->
    <script>
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@TempData["Success"]',
                icon: 'success',
                background: '#0b1329',
                color: '#f8fafc',
                confirmButtonColor: '#0077ff'
            });
            </text>
        }
        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({
                title: 'Attention!',
                text: '@TempData["Error"]',
                icon: 'error',
                background: '#0b1329',
                color: '#f8fafc',
                confirmButtonColor: '#ff3b30'
            });
            </text>
        }
    </script>
</body>
</html>
