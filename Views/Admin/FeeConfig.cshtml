@model NedAcademyWebsite.Models.FeeStructureConfig
@{
    ViewData["Title"] = "Fee Structure Configuration";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="font-headings text-white fw-bold m-0"><i class="fa-solid fa-file-invoice-dollar text-cyan me-2"></i>University Fee Structure Configuration</h3>
            <p class="text-muted small m-0">Edit itemized default fee components for initial semester vouchers</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-dark-success text-white border-success mb-4">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
        </div>
    }

    <form asp-action="SaveFeeConfig" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="glass-card p-4" style="max-width: 800px;">
            <h5 class="text-white font-headings fw-bold mb-4 border-bottom border-secondary pb-2">
                <i class="fa-solid fa-calculator text-cyan me-2"></i>Itemized Initial Semester Fee Breakdown
            </h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-cyan small fw-bold">Admission Fee (PKR)</label>
                    <input type="number" step="100" name="AdmissionFee" class="form-control bg-dark text-white border-secondary" value="@Model.AdmissionFee" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-cyan small fw-bold">Registration Fee (PKR)</label>
                    <input type="number" step="100" name="RegistrationFee" class="form-control bg-dark text-white border-secondary" value="@Model.RegistrationFee" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-cyan small fw-bold">Security Deposit (Refundable) (PKR)</label>
                    <input type="number" step="100" name="SecurityDeposit" class="form-control bg-dark text-white border-secondary" value="@Model.SecurityDeposit" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-cyan small fw-bold">Library Fee (PKR)</label>
                    <input type="number" step="100" name="LibraryFee" class="form-control bg-dark text-white border-secondary" value="@Model.LibraryFee" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-cyan small fw-bold">Laboratory Fee (PKR)</label>
                    <input type="number" step="100" name="LabFee" class="form-control bg-dark text-white border-secondary" value="@Model.LabFee" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-cyan small fw-bold">Student Activity Fee (PKR)</label>
                    <input type="number" step="100" name="StudentActivityFee" class="form-control bg-dark text-white border-secondary" value="@Model.StudentActivityFee" required />
                </div>
                <div class="col-md-12">
                    <label class="form-label text-cyan small fw-bold">Tuition / Semester Fee (PKR)</label>
                    <input type="number" step="500" name="SemesterFee" class="form-control bg-dark text-white border-secondary" value="@Model.SemesterFee" required />
                </div>
            </div>

            <div class="p-3 my-4 rounded border border-info" style="background: rgba(6, 182, 212, 0.05);">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Total First Semester Initial Base Fee:</span>
                    <span class="fs-5 text-cyan fw-bold">PKR @((Model.AdmissionFee + Model.RegistrationFee + Model.SecurityDeposit + Model.LibraryFee + Model.LabFee + Model.StudentActivityFee + Model.SemesterFee).ToString("N0"))</span>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-cyber px-4"><i class="fa-solid fa-save me-1"></i> Update Fee Structure</button>
            </div>
        </div>
    </form>
</div>
