@model IEnumerable<NedAcademyWebsite.Models.AuditLog>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "System Audit Activity Stream";
}

<div class="d-flex justify-content-between align-items-center mb-5 reveal-up">
    <div>
        <h1 class="display-5 font-headings fw-bold m-0 text-white">System Audit Activity Logs</h1>
        <p class="text-muted m-0">Review administrative mutation logs, timestamped action records, and security updates.</p>
    </div>
</div>

<div class="glass-card p-4 reveal-up">
    <div class="table-responsive">
        <table class="table table-dark table-hover table-borderless m-0" style="background:transparent; vertical-align:middle;">
            <thead>
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem;" class="text-muted text-uppercase font-headings">
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Performed By</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No audit logs recorded yet.</td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model)
                    {
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.92rem;">
                            <td class="text-muted font-monospace">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @if (log.Action == "Create")
                                {
                                    <span class="badge bg-success bg-opacity-20 text-success px-2 py-1 font-headings">CREATE</span>
                                }
                                else if (log.Action == "Update")
                                {
                                    <span class="badge bg-info bg-opacity-20 text-info px-2 py-1 font-headings">UPDATE</span>
                                }
                                else if (log.Action == "Delete" || log.Action == "SoftDelete")
                                {
                                    <span class="badge bg-danger bg-opacity-20 text-danger px-2 py-1 font-headings">DELETE</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary bg-opacity-20 text-primary px-2 py-1 font-headings">@log.Action.ToUpper()</span>
                                }
                            </td>
                            <td class="fw-semibold text-light">@log.EntityName</td>
                            <td class="text-muted">@log.Details</td>
                            <td><span class="badge bg-secondary font-monospace">@log.PerformedBy</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
